const flow = document.getElementById("flow");
const immerse = () => { const r = flow.getBoundingClientRect(); document.body.classList.toggle("immersive", r.top < 70 && r.bottom > innerHeight * 0.55); };
addEventListener("scroll", immerse, { passive: true }); immerse();

