---
import Base from "../layouts/Base.astro";
const B = import.meta.env.BASE_URL.replace(/\/?$/, "/");
// The six steps (plus step 0). cli is the Claude Code transcript for that step:
// ["you", zh, en] typed by you · ["ai", zh, en] Claude's reply · ["tool", zh, en, output] a tool call.
// tree: the folder after this step; "+" just appeared, "*" just changed.
const STEPS = [
  { zh: "呼叫 /slidejam", en: "Call /slidejam",
    ai: ["先問你要開新的，還是繼續某個資料夾。貼了標註清單，就直接從清單裡的路徑接著做。", "Asks: a new deck or an existing folder? A pasted annotation list carries its own path."],
    you: ["在 Claude Code 輸入 /slidejam，或直接說「做簡報」。", "Type /slidejam in Claude Code, or just say \"make me a deck\"."],
    cli: [["you", "/slidejam", "/slidejam"], ["ai", "（步驟 0）開一份新的，還是繼續某個資料夾的簡報？", "(step 0) A new deck, or carry on with a folder?"], ["you", "新的，介紹 civictech.tw 的建置成果", "New — what we built on civictech.tw"]],
    tree: [] },
  { zh: "開場五問", en: "Five questions",
    ai: ["一次問完：講什麼、講給誰、講多久、要秀哪些網站、你有幾小時。", "Asks all five at once: topic, audience, length, sites to show, hours you have."],
    you: ["回答。時間少，第一版就做精簡一點。", "Answer. Little time means a leaner first version."],
    cli: [["ai", "（步驟 1／6）先問五件事：\n1. 最想讓台下記住哪一句？\n2. 聽眾是誰？ 3. 講幾分鐘？\n4. 要秀哪些網站？ 5. 你有幾小時？", "(step 1/6) Five questions first:\n1. The one line they should remember?\n2. Audience? 3. Minutes?\n4. Sites to show? 5. Hours you have?"], ["you", "活動參與者，20 分鐘，秀 civictech.tw，我有一個半小時", "Event attendees, 20 min, civictech.tw, I have 90 minutes"]],
    tree: [] },
  { zh: "大綱", en: "Outline", gate: true,
    ai: ["每頁一句話，標出用哪個效果、需要哪些截圖。", "One line per slide, with the effect by name and the screenshots it needs."],
    you: ["刪、改、換順序，滿意了說「可以動工」。", "Cut, reword, reorder; say go when it's right."],
    cli: [["ai", "（步驟 2／6）大綱，12 頁：\n 1  開場　　　　letters\n 2  四個痛點　　bento\n 3  找得到　　　morph（拍 civictech.tw）\n …\n可以動工嗎？", "(step 2/6) Outline, 12 slides:\n 1  opening     letters\n 2  four pains  bento\n 3  findable    morph (capture civictech.tw)\n …\nGo?"], ["you", "第 5 頁拿掉，可以動工", "Drop slide 5 — go"]],
    tree: [] },
  { zh: "建檔", en: "Set up",
    ai: ["開資料夾、截圖、拍頁面重組動畫。", "Makes the folder, takes screenshots, captures morphs."],
    you: ["等。網站要登入的話，AI 會請你幫忙。", "Wait. If a site needs a login, the AI asks."],
    cli: [["tool", "Bash(node tools/new-deck.mjs ~/talks/civictech)", "Bash(node tools/new-deck.mjs ~/talks/civictech)", "✓ new deck at ~/talks/civictech"], ["tool", "Bash(node tools/capture-morph.mjs morph.config.mjs)", "Bash(node tools/capture-morph.mjs morph.config.mjs)", "✓ media/morph-project  (2 pairs, 3 rows)"], ["ai", "（步驟 3／6）資料夾開好了，拍了 6 張截圖、1 段 morph。", "(step 3/6) Folder ready: 6 screenshots and 1 morph."]],
    tree: ["+civictech/", "+  index.html", "+  deck/", "+  media/", "+    home.png …", "+    morph-project/"] },
  { zh: "第一版", en: "First version",
    ai: ["做完全部頁面和講稿，自己截圖檢查，告訴你哪裡不確定。", "Writes every slide and the notes, checks its own screenshots, says what it's unsure of."],
    you: ["用 Chrome 打開，從頭播一次。", "Open it in Chrome and play it through."],
    cli: [["tool", "Bash(node tools/shoot.mjs ~/talks/civictech/index.html --sheet)", "Bash(node tools/shoot.mjs ~/talks/civictech/index.html --sheet)", "✓ 12 slide(s) → .shots"], ["tool", "Read(.shots/sheet.png)", "Read(.shots/sheet.png)", "Read image"], ["ai", "（步驟 4／6）12 頁做好了，打開 ~/talks/civictech/index.html。\n不確定：第 7 頁的數字是去年的。\n字按 E 自己改；效果按 A 標起來貼給我。", "(step 4/6) 12 slides done — open ~/talks/civictech/index.html.\nUnsure: slide 7's numbers are last year's.\nFix words with E; mark effects with A and paste."]],
    tree: ["civictech/", "  index.html", "  deck/", "  media/", "    home.png …", "    morph-project/", "+  .shots/sheet.png"] },
  { zh: "來回修", en: "Rounds of changes",
    ai: ["一則一則處理，只重拍改到的頁，逐項回報。", "Handles each item, re-shoots only what changed, reports item by item."],
    you: ["字按 E 自己改；效果、版面按 A 點或框，貼清單。", "Words: E. Effects and layout: A, then paste the list."],
    cli: [["you", "1. 第 12 頁〈找得到〉\n   框住：元素內 9.6 18.9 24 7.7\n   想要：聚光燈打在標題上", "1. slide 12 (findable)\n   box: 9.6 18.9 24 7.7\n   want: spotlight on the title"], ["tool", "Edit(index.html)", "Edit(index.html)", "Updated with 1 change"], ["ai", "（步驟 5／6）第 12 頁加了 spot，框在標題。截圖如下。", "(step 5/6) Slide 12 now has a spot on the title. Screenshot below."]],
    tree: ["civictech/", "*  index.html", "  deck/", "  media/", "    home.png …", "    morph-project/", "  .shots/sheet.png"] },
  { zh: "上台前", en: "Before the talk",
    ai: ["陪你跑檢查清單：網路、字型、講者視窗、全螢幕、空白頁。", "Runs the checklist: network, fonts, presenter view, full screen, blank slides."],
    you: ["按 P 開講者視窗，排練一次。", "Press P for the presenter view and rehearse."],
    cli: [["ai", "（步驟 6／6）第 4 頁的地圖要網路。場地沒 Wi-Fi 的話，先換成截圖？", "(step 6/6) Slide 4's map needs a network. Swap in a screenshot in case there's no Wi-Fi?"], ["you", "好，換", "Yes, swap it"], ["tool", "Bash(node tools/shoot.mjs index.html 4)", "Bash(node tools/shoot.mjs index.html 4)", "✓ media/map.png"]],
    tree: ["civictech/", "  index.html", "  deck/", "  media/", "    home.png …", "+    map.png", "    morph-project/", "  .shots/sheet.png"] },
];
---
<Base title={'使用流程 — slidejam'} description={'跟 AI 用 slidejam 做簡報的完整流程：從說一句「做簡報」，到上台。'}>
<section class="page-hero"><div class="wrap">
  <p class="kicker"><span lang="zh">使用流程</span><span lang="en">Workflow</span></p>
  <h1><span lang="zh">從一句「做簡報」，到上台</span><span lang="en">From "make me a deck" to the stage</span></h1>
  <p><span lang="zh">slidejam 附了一個 Claude Code skill。你說「做簡報」，它會帶你走六個步驟，每一步都會說現在在第幾步、輪到誰做什麼。這頁把整個流程攤開。</span><span lang="en">slidejam ships a Claude Code skill. Say "make me a deck" and it walks you through six steps, always telling you which step you are on and whose turn it is. This page lays the whole flow out.</span></p>
</div></section>

<section class="block" id="setup"><div class="wrap">
  <h2><span lang="zh">準備（只要做一次）</span><span lang="en">Setup (once)</span></h2>
  <p class="lead"><span lang="zh">拿到 slidejam，再把 skill 連到 Claude Code。之後在任何資料夾開 Claude Code 都能用。</span><span lang="en">Get slidejam and link the skill into Claude Code. It then works from any folder.</span></p>
  <div class="twocol">
    <pre>git clone https://github.com/cooldongdong/slidejam
cd slidejam
npm install                      <span class="c"># 拍真網站動畫才需要</span>
npx playwright install chromium-headless-shell
ln -s "$PWD/skill" ~/.claude/skills/slidejam
<span class="c"># 之後在 Claude Code 輸入 /slidejam 就開始</span></pre>
    <div class="who" style="font-size:16px">
      <p style="margin:0 0 10px"><span lang="zh">沒有用 Claude Code 也可以：打開 <a href={B + "play/effects/"}>效果圖鑑</a> 挑效果，把按 A 標註出來的清單貼給任何一個 AI。</span><span lang="en">Not on Claude Code? Pick effects from the <a href={B + "play/effects/"}>gallery</a> and paste the lists you mark with A to any AI.</span></p>
      <p style="margin:0"><span lang="zh">需要 Chrome（改字存檔只有 Chrome 能用）和 Node.js 22 以上。</span><span lang="en">You need Chrome (saving edits is Chrome-only) and Node.js 22+.</span></p>
    </div>
  </div>
</div></section>

<section class="flowx" id="flow">
  <div class="wrap flowx-head">
    <h2><span lang="zh">六個步驟</span><span lang="en">Six steps</span></h2>
    <p class="lead"><span lang="zh">往下捲，看一場真實的對話重演：從輸入 /slidejam 開始，AI 每則訊息都標出走到第幾步，資料夾也一步步長出來。第 2 步之後要你說「可以動工」，AI 才會開始建檔。</span><span lang="en">Scroll to replay a real session, starting from /slidejam: every AI message names its step and the folder grows as you go. Nothing is created until you say go after step 2.</span></p>
  </div>
  <div class="fx-story">
    <div class="fx-sticky">
      <div class="term">
        <div class="term-bar"><i></i><i></i><i></i><span>~/talks — claude</span></div>
        <div class="term-body">
          <div class="term-log" id="log"></div>
          <aside class="term-tree"><b>~/talks/</b><div id="tree"></div></aside>
        </div>
        <div class="term-input"><span>&gt;</span><em id="typing"></em><i class="caret"></i></div>
        <div class="term-steps" id="dots">{STEPS.map((_, i) => <button data-k={i}>{i}</button>)}</div>
      </div>
    </div>
    <ol class="fx-steps">
      {STEPS.map((st, i) => (
        <li class="fx-step" data-k={i}>
          <span class="no">{i === 0 ? "0" : `${i} / 6`}</span>
          <h3><span lang="zh">{st.zh}</span><span lang="en">{st.en}</span>{st.gate && <small><span lang="zh">要你說「可以動工」</span><span lang="en">needs your go</span></small>}</h3>
          <div class="who"><b>AI</b><p><span lang="zh">{st.ai[0]}</span><span lang="en">{st.ai[1]}</span></p></div>
          <div class="who"><b><span lang="zh">你</span><span lang="en">You</span></b><p><span lang="zh">{st.you[0]}</span><span lang="en">{st.you[1]}</span></p></div>
          <div class="inline-cli">{st.cli.map(([kind, zh, en, out]) => <p class={kind}><span lang="zh">{zh}</span><span lang="en">{en}</span>{out && <em>⎿ {out}</em>}</p>)}</div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="block" id="decks"><div class="wrap">
  <h2><span lang="zh">第二份簡報、隔天接著做</span><span lang="en">More decks, and picking up later</span></h2>
  <p class="lead"><span lang="zh">每份簡報都是一個獨立的資料夾，裡面有自己的一份引擎。做第二份不會影響第一份。</span><span lang="en">Every deck is its own folder with its own copy of the engine. A second deck never touches the first.</span></p>
  <div class="cases">
    <div class="case"><h3><span lang="zh">開第二份</span><span lang="en">A second deck</span></h3>
      <p><span lang="zh">再說一次「做簡報」，選「開新的」，給它另一個名字。</span><span lang="en">Say "make me a deck" again, choose new, give it another name.</span></p>
      <pre>~/talks/civictech/
~/talks/misheng/   <span class="c"># 互不影響</span></pre></div>
    <div class="case"><h3><span lang="zh">隔天、開新對話接著做</span><span lang="en">Tomorrow, in a new chat</span></h3>
      <p><span lang="zh">說「繼續做 ~/talks/misheng」，或直接貼標註清單。清單第一行就有檔案路徑，AI 會自己找到是哪一份，直接從第 5 步接著改。</span><span lang="en">Say "carry on with ~/talks/misheng", or just paste an annotation list. Its first lines carry the path, so the AI goes straight to step 5.</span></p></div>
    <div class="case"><h3><span lang="zh">slidejam 出了新效果</span><span lang="en">slidejam gains effects</span></h3>
      <p><span lang="zh">在 slidejam 資料夾 <code>git pull</code>，再更新那份簡報的引擎。投影片和素材都不會動。</span><span lang="en"><code>git pull</code> slidejam, then refresh that deck's engine. Slides and media stay as they are.</span></p>
      <pre>node tools/new-deck.mjs ~/talks/misheng --update</pre></div>
  </div>
</div></section>

<section class="block" id="tools"><div class="wrap">
  <h2><span lang="zh">在簡報裡的按鍵</span><span lang="en">Keys inside a deck</span></h2>
  <p class="lead"><span lang="zh">忘了的話，按 ? 或點左下角的小問號：點一列就直接執行，點右邊的鍵可以換成別的鍵（跟其他工具衝突時很好用）。</span><span lang="en">Forgot? Press ? or the small button bottom-left: click a row to run it, click a key to change it (handy when another tool grabs it).</span></p>
  <div class="keys">
    <div><kbd>→</kbd><span lang="zh">下一步、下一頁</span><span lang="en">next step / slide</span></div>
    <div><kbd>←</kbd><span lang="zh">上一頁</span><span lang="en">previous slide</span></div>
    <div><kbd>G</kbd><span lang="zh">總覽：點縮圖跳頁；「▶ 播放全部」讓每頁一起動</span><span lang="en">overview: click to jump; ▶ Play all runs every slide</span></div>
    <div><kbd>P</kbd><span lang="zh">講者視窗：講稿、下一頁、計時，只在你的螢幕</span><span lang="en">presenter view: notes, next slide, clock — your screen only</span></div>
    <div><kbd>N</kbd><span lang="zh">在同一個視窗看講稿</span><span lang="en">notes in the same window</span></div>
    <div><kbd>E</kbd><span lang="zh">直接改字，⌘S 存回檔案</span><span lang="en">edit text in place, ⌘S saves the file</span></div>
    <div><kbd>A</kbd><span lang="zh">標註給 AI：點一下或拖拉框選</span><span lang="en">annotate for the AI: click or drag a box</span></div>
    <div><kbd>R</kbd><span lang="zh">重播這一頁</span><span lang="en">replay this slide</span></div>
    <div><kbd>F</kbd><span lang="zh">全螢幕</span><span lang="en">full screen</span></div>
  </div>
  <div class="tools">
    <div><h3><span lang="zh">A：說不清楚的，框起來</span><span lang="en">A: box what's hard to describe</span></h3><p><span lang="zh">清單有頁碼、元素和精確位置，AI 不用猜。</span><span lang="en">The list has the slide, the element and exact coordinates.</span></p>
      <div class="screen"><iframe src={B + "demos/annotate.html?embed&loop=10"} title="annotate" loading="lazy" tabindex="-1"></iframe></div></div>
    <div><h3><span lang="zh">E：字自己改最快</span><span lang="en">E: fixing words yourself is fastest</span></h3><p><span lang="zh">⌘S 只換掉改過的那一行，其他一個字都不動。</span><span lang="en">⌘S replaces only the line you changed.</span></p>
      <div class="screen"><iframe src={B + "demos/edit.html?embed&loop=8"} title="edit" loading="lazy" tabindex="-1"></iframe></div></div>
  </div>
</div></section>

<section class="block" id="effects"><div class="wrap">
  <h2><span lang="zh">效果放在哪？怎麼加新的？</span><span lang="en">Where effects live, and adding one</span></h2>
  <div class="twocol" style="margin-top:22px">
    <div>
      <p class="lead" style="margin-bottom:16px"><span lang="zh">一個效果一個檔案，JS 和樣式都在裡面。簡報打開時，引擎只載入這份簡報用到的效果。</span><span lang="en">One file per effect, script and styles together. A deck loads only the effects it uses.</span></p>
      <div class="tree">deck/
  deck.js      <span class="c"># 翻頁、總覽、E、A、P、W</span>
  deck.css
  fx/
    _lib.js    <span class="c"># 效果共用的小工具</span>
    bento.js   <span class="c"># 一個效果一個檔</span>
    morph.js
    map.js
    …</div>
    </div>
    <div>
      <p class="lead" style="margin-bottom:16px"><span lang="zh">圖鑑裡沒有想要的？跟 AI 描述，或按 A 標出來。它會：</span><span lang="en">Not in the gallery? Describe it or mark it with A. The AI will:</span></p>
      <ol class="plain">
        <li><span lang="zh">在 <code>deck/fx/</code> 加一個新檔案</span><span lang="en">add a file in <code>deck/fx/</code></span></li>
        <li><span lang="zh">在效果圖鑑加一頁示範，寫好「跟 AI 這樣說」</span><span lang="en">add a gallery slide with a demo and a line to ask with</span></li>
        <li><span lang="zh">用 <code>--update</code> 把它帶進你的簡報</span><span lang="en">bring it into your deck with <code>--update</code></span></li>
      </ol>
      <p style="color:var(--ink-muted);font-size:15px;margin-top:16px"><span lang="zh">下次就能直接叫名字。<a href={B + "play/effects/?wall"}>看目前所有效果 →</a></span><span lang="en">Next time, just call it by name. <a href={B + "play/effects/?wall"}>See every effect →</a></span></p>
    </div>
  </div>
</div></section>
</Base>

<script is:inline define:vars={{ STEPS }}>
// One continuous session: when a step becomes active, everything before it is already in the
// log and this step plays out — you type into the prompt, Claude thinks, tools run.
const log = document.getElementById("log"), tree = document.getElementById("tree"), typing = document.getElementById("typing");
const dots = [...document.querySelectorAll("#dots button")], steps = [...document.querySelectorAll(".fx-step")];
const L = () => (document.documentElement.dataset.lang === "en" ? 2 : 1);
let cur = -1, timers = [];
const line = (m, old) => {
  const d = document.createElement("div");
  d.className = m[0] + (old ? " old" : "");
  if (m[0] === "tool") { const t = m[L()]; const k = t.indexOf("("); d.innerHTML = `<b></b><span></span><em></em>`; d.children[0].textContent = t.slice(0, k); d.children[1].textContent = t.slice(k); d.children[2].textContent = "⎿  " + m[3]; }
  else d.textContent = m[L()];
  log.appendChild(d);
};
function drawTree(k) {
  const st = STEPS[k];
  tree.innerHTML = st.tree.length ? "" : `<span class="empty">${L() === 2 ? "(empty)" : "（還是空的）"}</span>`;
  st.tree.forEach((t) => { const d = document.createElement("div"); const m = t[0]; d.textContent = m === "+" || m === "*" ? t.slice(1) : t; if (m === "+") d.className = "new"; if (m === "*") d.className = "mod"; tree.appendChild(d); });
}
function play(k, animate) {
  timers.forEach(clearTimeout); timers = [];
  typing.textContent = "";
  log.innerHTML = "";
  for (let j = 0; j < k; j++) STEPS[j].cli.forEach((m) => line(m, true));
  dots.forEach((d, j) => { d.classList.toggle("on", j === k); d.classList.toggle("done", j < k); });
  steps.forEach((s, j) => s.classList.toggle("on", j === k));
  drawTree(k);
  if (!animate) return STEPS[k].cli.forEach((m) => line(m));
  let t = 250;
  const at = (ms, f) => timers.push(setTimeout(f, ms));
  STEPS[k].cli.forEach((m) => {
    if (m[0] === "you") {
      const text = m[L()], per = Math.min(45, 900 / text.length);
      [...text].forEach((_, i) => at(t + i * per, () => (typing.textContent = text.slice(0, i + 1))));
      t += text.length * per + 250;
      at(t, () => { typing.textContent = ""; line(m); });
      t += 400;
    } else {
      at(t, () => { const d = document.createElement("div"); d.className = "think"; d.textContent = L() === 2 ? "Thinking…" : "思考中…"; log.appendChild(d); });
      t += 700;
      at(t, () => { log.querySelector(".think")?.remove(); line(m); });
      t += m[0] === "tool" ? 500 : 650;
    }
  });
}
const io = new IntersectionObserver((es) => es.forEach((e) => {
  if (!e.isIntersecting) return;
  const k = +e.target.dataset.k;
  if (k !== cur) { cur = k; play(k, true); }
}), { rootMargin: "-45% 0px -45% 0px" });
steps.forEach((s) => io.observe(s));
play(0, false); cur = 0;
new MutationObserver(() => play(cur, false)).observe(document.documentElement, { attributes: true, attributeFilter: ["data-lang"] });
dots.forEach((d) => d.addEventListener("click", () => steps[+d.dataset.k].scrollIntoView({ behavior: "smooth", block: "center" })));
</script>

<style is:global>
.page-hero{padding:64px 0 24px}
.page-hero h1{font-size:clamp(34px,5vw,58px);line-height:1.15;margin:0;letter-spacing:-.02em}
.page-hero p{font-size:19px;color:var(--ink-2);max-width:760px;margin:18px 0 0}
.block{padding:56px 0;border-top:1px solid var(--line)}
.block h2{font-size:clamp(26px,3.2vw,36px);margin:0 0 10px}
