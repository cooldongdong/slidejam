---
import Base from "../layouts/Base.astro";
const B = import.meta.env.BASE_URL.replace(/\/?$/, "/");
// The six steps (plus step 0), shared by the scroll story and the inline chat on phones.
// chat: [who, 中文, English]; tree: the folder after this step, "+" marks what just appeared.
const STEPS = [
  { zh: "要做哪一份？", en: "Which deck?",
    ai: ["問你要開新的，還是繼續某個資料夾。貼了標註清單，就直接從清單裡的路徑接著做。", "Asks: new deck or an existing folder? A pasted annotation list carries its own path."],
    you: ["說「做簡報」，或「繼續做 ~/talks/xxx」。", "Say \"make me a deck\", or \"carry on with ~/talks/xxx\"."],
    chat: [["me", "幫我做簡報", "Make me a deck"], ["ai", "（步驟 0）開一份新的，還是繼續某個資料夾的簡報？", "(step 0) A new one, or carry on with a folder?"], ["me", "新的，介紹 civictech.tw", "New — about civictech.tw"]],
    tree: [] },
  { zh: "開場五問", en: "Five questions",
    ai: ["一次問完：講什麼、講給誰、講多久、要秀哪些網站、你有幾小時。", "Asks all five at once: topic, audience, length, sites to show, hours you have."],
    you: ["回答。時間少，第一版就做精簡一點。", "Answer. Little time means a leaner first version."],
    chat: [["ai", "（步驟 1／6）1. 最想讓台下記住哪一句？2. 聽眾是誰？3. 幾分鐘？4. 要秀哪些網站？5. 你有幾小時？", "(step 1/6) 1. The one line to remember? 2. Audience? 3. Minutes? 4. Which sites? 5. Hours you have?"], ["me", "活動參與者、20 分鐘，秀 civictech.tw，我有一個半小時", "Event attendees, 20 min, show civictech.tw, I have 90 minutes"]],
    tree: [] },
  { zh: "大綱", en: "Outline", gate: true,
    ai: ["每頁一句話，標出用哪個效果、需要哪些截圖。", "One line per slide, with the effect by name and the screenshots it needs."],
    you: ["刪、改、換順序，滿意了說「可以動工」。", "Cut, reword, reorder; say go when it's right."],
    chat: [["ai", "（步驟 2／6）1 開場 letters／2 痛點 bento／3 找得到：議題頁點進專案頁（morph）……要動工嗎？", "(step 2/6) 1 opening, letters / 2 pains, bento / 3 findable: topic → project (morph)… go?"], ["me", "第 5 頁拿掉，可以動工", "Drop slide 5 — go"]],
    tree: [] },
  { zh: "建檔", en: "Set up",
    ai: ["開資料夾、截圖、拍頁面重組動畫。", "Makes the folder, takes screenshots, captures morphs."],
    you: ["等。網站要登入的話，AI 會請你幫忙。", "Wait. If a site needs a login, the AI asks."],
    chat: [["ai", "（步驟 3／6）~/talks/civictech 開好了，拍了 6 張截圖、1 段 morph。", "(step 3/6) ~/talks/civictech is ready: 6 screenshots, 1 morph."]],
    tree: ["+civictech/", "+  index.html", "+  deck/", "+  media/", "+    home.png …6 張", "+    morph-project/"] },
  { zh: "第一版", en: "First version",
    ai: ["做完全部頁面和講稿，自己截圖檢查，告訴你哪裡不確定。", "Writes every slide and the notes, checks its own screenshots, says what it's unsure of."],
    you: ["用 Chrome 打開，從頭播一次。", "Open it in Chrome and play it through."],
    chat: [["ai", "（步驟 4／6）12 頁做好了。打開 index.html。不確定：第 7 頁的數字是去年的。字按 E 自己改；效果按 A 標起來貼給我。", "(step 4/6) 12 slides done. Open index.html. Unsure: slide 7's numbers are last year's. Fix words with E; mark effects with A and paste them."]],
    tree: ["civictech/", "  index.html", "  deck/", "  media/", "    home.png …6 張", "    morph-project/", "+  .shots/sheet.png"] },
  { zh: "來回修", en: "Rounds of changes",
    ai: ["一則一則處理，只重拍改到的頁，逐項回報。", "Handles each item, re-shoots only what changed, reports item by item."],
    you: ["字按 E 自己改；效果、版面按 A 點或框，貼清單。", "Words: E. Effects and layout: A, then paste the list."],
    chat: [["me", "1. 第 12 頁〈找得到〉框住：9.6 18.9 24 7.7　想要：聚光燈打在標題上", "1. slide 12 — box: 9.6 18.9 24 7.7 — want: spotlight on the title"], ["ai", "（步驟 5／6）第 12 頁加了 spot，框在標題。截圖如下。", "(step 5/6) Slide 12 has a spot on the title. Screenshot below."]],
    tree: ["civictech/", "*  index.html", "  deck/", "  media/", "    home.png …6 張", "    morph-project/", "  .shots/sheet.png"] },
  { zh: "上台前", en: "Before the talk",
    ai: ["陪你跑檢查清單：網路、字型、講者視窗、全螢幕、空白頁。", "Runs the checklist: network, fonts, presenter view, full screen, blank slides."],
    you: ["按 P 開講者視窗，排練一次。", "Press P for the presenter view and rehearse."],
    chat: [["ai", "（步驟 6／6）第 4 頁的地圖要網路，場地沒 Wi-Fi 的話，先換成截圖？", "(step 6/6) Slide 4's map needs a network. Swap in a screenshot in case there's no Wi-Fi?"], ["me", "好，換", "Yes, swap it"]],
    tree: ["civictech/", "  index.html", "  deck/", "  media/", "    home.png …6 張", "+    map.png", "    morph-project/", "  .shots/sheet.png"] },
];
---
<Base title={'使用流程 — slidejam'} description={'跟 AI 用 slidejam 做簡報的完整流程：從說一句「做簡報」，到上台。'}>
<section class="page-hero"><div class="wrap">
  <p class="kicker"><span lang="zh">使用流程</span><span lang="en">Workflow</span></p>
  <h1><span lang="zh">從一句「做簡報」，到上台</span><span lang="en">From "make me a deck" to the stage</span></h1>
  <p><span lang="zh">slidejam 附了一個 Claude Code skill。你說「做簡報」，它會帶你走六個步驟，每一步都會說現在在第幾步、輪到誰做什麼。這頁把整個流程攤開。</span><span lang="en">slidejam ships a Claude Code skill. Say "make me a deck" and it walks you through six steps, always telling you which step you are on and whose turn it is. This page lays the whole flow out.</span></p>
</div></section>

<section class="block" id="setup"><div class="wrap">
  <h2><span lang="zh">準備（只要做一次）</span><span lang="en">Setup (once)</span></h2>
  <p class="lead"><span lang="zh">拿到 slidejam，再把 skill 連到 Claude Code。之後在任何資料夾開 Claude Code 都能用。</span><span lang="en">Get slidejam and link the skill into Claude Code. It then works from any folder.</span></p>
  <div class="twocol">
    <pre>git clone https://github.com/cooldongdong/slidejam
cd slidejam
npm install                      <span class="c"># 拍真網站動畫才需要</span>
npx playwright install chromium-headless-shell
ln -s "$PWD/skill" ~/.claude/skills/slidejam</pre>
    <div class="who" style="font-size:16px">
      <p style="margin:0 0 10px"><span lang="zh">沒有用 Claude Code 也可以：打開 <a href={B + "play/effects/"}>效果圖鑑</a> 挑效果，把按 A 標註出來的清單貼給任何一個 AI。</span><span lang="en">Not on Claude Code? Pick effects from the <a href={B + "play/effects/"}>gallery</a> and paste the lists you mark with A to any AI.</span></p>
      <p style="margin:0"><span lang="zh">需要 Chrome（改字存檔只有 Chrome 能用）和 Node.js 22 以上。</span><span lang="en">You need Chrome (saving edits is Chrome-only) and Node.js 22+.</span></p>
    </div>
  </div>
</div></section>

<section class="block flowx" id="flow"><div class="wrap">
  <h2><span lang="zh">六個步驟</span><span lang="en">Six steps</span></h2>
  <p class="lead"><span lang="zh">往下捲，會重演一次真的對話：AI 每則訊息都標出「（步驟 2／6）」，資料夾也一步步長出來。第 2 步之後要你說「可以動工」，AI 才會開始建檔。</span><span lang="en">Scroll and a real conversation replays: every AI message names its step, and the folder grows as you go. Nothing is created until you say go after step 2.</span></p>
  <div class="fx-story">
    <div class="fx-sticky">
      <div class="term">
        <div class="term-bar"><i></i><i></i><i></i><span>Claude Code — ~/talks/civictech</span></div>
        <div class="term-body">
          <div class="term-chat" id="chat"></div>
          <div class="term-tree"><b>~/talks/</b><div id="tree"></div></div>
        </div>
        <div class="term-steps" id="dots">{STEPS.map((_, i) => <i data-k={i}>{i}</i>)}</div>
      </div>
    </div>
    <ol class="fx-steps">
      {STEPS.map((st, i) => (
        <li class="fx-step" data-k={i}>
          <span class="no">{i === 0 ? "0" : `${i} / 6`}</span>
          <h3><span lang="zh">{st.zh}</span><span lang="en">{st.en}</span>{st.gate && <small><span lang="zh">要你說「可以動工」</span><span lang="en">needs your go</span></small>}</h3>
          <div class="who"><b>AI</b><p><span lang="zh">{st.ai[0]}</span><span lang="en">{st.ai[1]}</span></p></div>
          <div class="who"><b><span lang="zh">你</span><span lang="en">You</span></b><p><span lang="zh">{st.you[0]}</span><span lang="en">{st.you[1]}</span></p></div>
          <div class="inline-chat">{st.chat.map(([who, zh, en]) => <p class={who}><span lang="zh">{zh}</span><span lang="en">{en}</span></p>)}</div>
        </li>
      ))}
    </ol>
  </div>
</div></section>

<section class="block" id="decks"><div class="wrap">
  <h2><span lang="zh">第二份簡報、隔天接著做</span><span lang="en">More decks, and picking up later</span></h2>
  <p class="lead"><span lang="zh">每份簡報都是一個獨立的資料夾，裡面有自己的一份引擎。做第二份不會影響第一份。</span><span lang="en">Every deck is its own folder with its own copy of the engine. A second deck never touches the first.</span></p>
  <div class="cases">
    <div class="case"><h3><span lang="zh">開第二份</span><span lang="en">A second deck</span></h3>
      <p><span lang="zh">再說一次「做簡報」，選「開新的」，給它另一個名字。</span><span lang="en">Say "make me a deck" again, choose new, give it another name.</span></p>
      <pre>~/talks/civictech/
~/talks/misheng/   <span class="c"># 互不影響</span></pre></div>
    <div class="case"><h3><span lang="zh">隔天、開新對話接著做</span><span lang="en">Tomorrow, in a new chat</span></h3>
      <p><span lang="zh">說「繼續做 ~/talks/misheng」，或直接貼標註清單。清單第一行就有檔案路徑，AI 會自己找到是哪一份，直接從第 5 步接著改。</span><span lang="en">Say "carry on with ~/talks/misheng", or just paste an annotation list. Its first lines carry the path, so the AI goes straight to step 5.</span></p></div>
    <div class="case"><h3><span lang="zh">slidejam 出了新效果</span><span lang="en">slidejam gains effects</span></h3>
      <p><span lang="zh">在 slidejam 資料夾 <code>git pull</code>，再更新那份簡報的引擎。投影片和素材都不會動。</span><span lang="en"><code>git pull</code> slidejam, then refresh that deck's engine. Slides and media stay as they are.</span></p>
      <pre>node tools/new-deck.mjs ~/talks/misheng --update</pre></div>
  </div>
</div></section>

<section class="block" id="tools"><div class="wrap">
  <h2><span lang="zh">在簡報裡的按鍵</span><span lang="en">Keys inside a deck</span></h2>
  <p class="lead"><span lang="zh">忘了的話，按 ? 或點左下角的小問號：點一列就直接執行，點右邊的鍵可以換成別的鍵（跟其他工具衝突時很好用）。</span><span lang="en">Forgot? Press ? or the small button bottom-left: click a row to run it, click a key to change it (handy when another tool grabs it).</span></p>
  <div class="keys">
    <div><kbd>→</kbd><span lang="zh">下一步、下一頁</span><span lang="en">next step / slide</span></div>
    <div><kbd>←</kbd><span lang="zh">上一頁</span><span lang="en">previous slide</span></div>
    <div><kbd>G</kbd><span lang="zh">總覽：點縮圖跳頁；「▶ 播放全部」讓每頁一起動</span><span lang="en">overview: click to jump; ▶ Play all runs every slide</span></div>
    <div><kbd>P</kbd><span lang="zh">講者視窗：講稿、下一頁、計時，只在你的螢幕</span><span lang="en">presenter view: notes, next slide, clock — your screen only</span></div>
    <div><kbd>N</kbd><span lang="zh">在同一個視窗看講稿</span><span lang="en">notes in the same window</span></div>
    <div><kbd>E</kbd><span lang="zh">直接改字，⌘S 存回檔案</span><span lang="en">edit text in place, ⌘S saves the file</span></div>
    <div><kbd>A</kbd><span lang="zh">標註給 AI：點一下或拖拉框選</span><span lang="en">annotate for the AI: click or drag a box</span></div>
    <div><kbd>R</kbd><span lang="zh">重播這一頁</span><span lang="en">replay this slide</span></div>
    <div><kbd>F</kbd><span lang="zh">全螢幕</span><span lang="en">full screen</span></div>
  </div>
  <div class="tools">
    <div><h3><span lang="zh">A：說不清楚的，框起來</span><span lang="en">A: box what's hard to describe</span></h3><p><span lang="zh">清單有頁碼、元素和精確位置，AI 不用猜。</span><span lang="en">The list has the slide, the element and exact coordinates.</span></p>
      <div class="screen"><iframe src={B + "demos/annotate.html?embed&loop=10"} title="annotate" loading="lazy" tabindex="-1"></iframe></div></div>
    <div><h3><span lang="zh">E：字自己改最快</span><span lang="en">E: fixing words yourself is fastest</span></h3><p><span lang="zh">⌘S 只換掉改過的那一行，其他一個字都不動。</span><span lang="en">⌘S replaces only the line you changed.</span></p>
      <div class="screen"><iframe src={B + "demos/edit.html?embed&loop=8"} title="edit" loading="lazy" tabindex="-1"></iframe></div></div>
  </div>
</div></section>

<section class="block" id="effects"><div class="wrap">
  <h2><span lang="zh">效果放在哪？怎麼加新的？</span><span lang="en">Where effects live, and adding one</span></h2>
  <div class="twocol" style="margin-top:22px">
    <div>
      <p class="lead" style="margin-bottom:16px"><span lang="zh">一個效果一個檔案，JS 和樣式都在裡面。簡報打開時，引擎只載入這份簡報用到的效果。</span><span lang="en">One file per effect, script and styles together. A deck loads only the effects it uses.</span></p>
      <div class="tree">deck/
  deck.js      <span class="c"># 翻頁、總覽、E、A、P、W</span>
  deck.css
  fx/
    _lib.js    <span class="c"># 效果共用的小工具</span>
    bento.js   <span class="c"># 一個效果一個檔</span>
    morph.js
    map.js
    …</div>
    </div>
    <div>
      <p class="lead" style="margin-bottom:16px"><span lang="zh">圖鑑裡沒有想要的？跟 AI 描述，或按 A 標出來。它會：</span><span lang="en">Not in the gallery? Describe it or mark it with A. The AI will:</span></p>
      <ol class="plain">
        <li><span lang="zh">在 <code>deck/fx/</code> 加一個新檔案</span><span lang="en">add a file in <code>deck/fx/</code></span></li>
        <li><span lang="zh">在效果圖鑑加一頁示範，寫好「跟 AI 這樣說」</span><span lang="en">add a gallery slide with a demo and a line to ask with</span></li>
        <li><span lang="zh">用 <code>--update</code> 把它帶進你的簡報</span><span lang="en">bring it into your deck with <code>--update</code></span></li>
      </ol>
      <p style="color:var(--ink-muted);font-size:15px;margin-top:16px"><span lang="zh">下次就能直接叫名字。<a href={B + "play/effects/?wall"}>看目前所有效果 →</a></span><span lang="en">Next time, just call it by name. <a href={B + "play/effects/?wall"}>See every effect →</a></span></p>
    </div>
  </div>
</div></section>
</Base>

<script is:inline define:vars={{ STEPS }}>
// replay the active step in the window: messages arrive one by one (the AI "types" first),
// and the folder shows what just appeared or changed
const chat = document.getElementById("chat"), tree = document.getElementById("tree");
const dots = [...document.querySelectorAll("#dots i")], steps = [...document.querySelectorAll(".fx-step")];
const lang = () => (document.documentElement.dataset.lang === "en" ? 2 : 1);
let cur = -1, timers = [];
function render(k, animate) {
  timers.forEach(clearTimeout); timers = [];
  const st = STEPS[k];
  chat.innerHTML = "";
  let t = 0;
  st.chat.forEach((m) => {
    const say = () => { const p = document.createElement("p"); p.className = m[0]; p.textContent = m[lang()]; chat.appendChild(p); };
    if (!animate) return say();
    if (m[0] === "ai") {
      timers.push(setTimeout(() => { const d = document.createElement("p"); d.className = "ai typing"; d.innerHTML = "<i></i><i></i><i></i>"; chat.appendChild(d); }, t));
      t += 700;
      timers.push(setTimeout(() => { chat.querySelector(".typing")?.remove(); say(); }, t));
    } else timers.push(setTimeout(say, t));
    t += 650;
  });
  tree.innerHTML = st.tree.length ? "" : `<span class="empty">${lang() === 2 ? "(empty)" : "（還是空的）"}</span>`;
  st.tree.forEach((line) => {
    const d = document.createElement("div");
    const mark = line[0];
    d.textContent = mark === "+" || mark === "*" ? line.slice(1) : line;
    if (mark === "+") d.className = "new";
    if (mark === "*") d.className = "mod";
    tree.appendChild(d);
  });
  dots.forEach((d, j) => { d.classList.toggle("on", j === k); d.classList.toggle("done", j < k); });
  steps.forEach((s, j) => s.classList.toggle("on", j === k));
}
const io = new IntersectionObserver((es) => es.forEach((e) => {
  if (!e.isIntersecting) return;
  const k = +e.target.dataset.k;
  if (k !== cur) { cur = k; render(k, true); }
}), { rootMargin: "-45% 0px -45% 0px" });
steps.forEach((s) => io.observe(s));
render(0, false); cur = 0;
new MutationObserver(() => render(cur, false)).observe(document.documentElement, { attributes: true, attributeFilter: ["data-lang"] });
dots.forEach((d) => d.addEventListener("click", () => steps[+d.dataset.k].scrollIntoView({ behavior: "smooth", block: "center" })));
</script>

<style is:global>
.page-hero{padding:64px 0 24px}
.page-hero h1{font-size:clamp(34px,5vw,58px);line-height:1.15;margin:0;letter-spacing:-.02em}
.page-hero p{font-size:19px;color:var(--ink-2);max-width:760px;margin:18px 0 0}
.block{padding:56px 0;border-top:1px solid var(--line)}
.block h2{font-size:clamp(26px,3.2vw,36px);margin:0 0 10px}
.block > .wrap > p.lead{font-size:18px;color:var(--ink-2);margin:0 0 28px;max-width:760px}
.fstep > .who:nth-of-type(1){grid-area:a}.fstep > .who:nth-of-type(2){grid-area:b}.twocol > *,.case,.tools > *{min-width:0}
.cases{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.case{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:22px}
.case h3{margin:0 0 10px;font-size:19px}
.case p{margin:0 0 12px;color:var(--ink-2);font-size:15.5px}
.keys{display:grid;grid-template-columns:repeat(2,1fr);gap:12px 28px}
.keys div{display:grid;grid-template-columns:70px 1fr;gap:12px;align-items:baseline;font-size:16px;color:var(--ink-2)}
.keys kbd{font:600 15px var(--mono);background:var(--surface);border:1px solid var(--line-strong);border-bottom-width:3px;border-radius:8px;padding:3px 0;text-align:center;color:var(--ink)}
.tools{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:32px}
.tools .screen{margin-top:10px}
.tools h3{margin:0;font-size:19px}
.tools p{margin:6px 0 0;color:var(--ink-2);font-size:15.5px}
.tree{background:#0f1719;color:#d6e2e5;border-radius:14px;padding:18px 22px;font:15px/1.7 var(--mono);white-space:pre;overflow-x:auto}
.tree .c{color:#7d9096}
.twocol{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:start}
ol.plain{margin:0;padding-left:22px;color:var(--ink-2);font-size:16px}
ol.plain li{margin-bottom:8px}
code{font-family:var(--mono);font-size:.92em;background:var(--surface-2);padding:1px 6px;border-radius:5px}
@media (max-width:860px){
    .cases,.keys,.tools,.twocol{grid-template-columns:1fr}
}

/* ---- six steps as a scroll story: a sticky Claude Code window replays each step ---- */
.fx-story{display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:start}
.fx-sticky{position:sticky;top:96px}
.term{background:#0f1719;color:#d6e2e5;border-radius:16px;overflow:hidden;box-shadow:0 40px 80px -40px rgb(15 26 29/.6)}
.term-bar{display:flex;align-items:center;gap:7px;padding:12px 16px;background:#172126;font:13px var(--mono);color:#8a9ca3}
.term-bar i{width:11px;height:11px;border-radius:50%;background:#e06c5f}.term-bar i:nth-child(2){background:#e3b341}.term-bar i:nth-child(3){background:#5fb15f}
.term-bar span{margin-left:10px}
.term-body{display:grid;grid-template-columns:1fr 190px;min-height:400px}
.term-chat{padding:18px;display:flex;flex-direction:column;gap:10px;justify-content:flex-end}
.term-chat p{margin:0;max-width:92%;padding:10px 14px;border-radius:14px;font-size:14.5px;line-height:1.55;animation:msg .45s cubic-bezier(.16,1,.3,1)}
.term-chat .me{align-self:flex-end;background:#0d5f74;color:#fff;border-radius:14px 14px 4px 14px}
.term-chat .ai{align-self:flex-start;background:#1f2b31;color:#e8eef5;border-radius:14px 14px 14px 4px}
.term-chat .typing{display:flex;gap:5px;padding:13px 14px}
.term-chat .typing i{width:7px;height:7px;border-radius:50%;background:#8a9ca3;animation:dot 1s infinite}
.term-chat .typing i:nth-child(2){animation-delay:.15s}.term-chat .typing i:nth-child(3){animation-delay:.3s}
@keyframes msg{from{opacity:0;transform:translateY(10px)}}
@keyframes dot{30%{transform:translateY(-4px);opacity:1}0%,60%,100%{opacity:.4}}
.term-tree{border-left:1px solid #22313a;padding:18px 16px;font:13px/1.9 var(--mono);color:#8a9ca3;white-space:pre}
.term-tree b{color:#d6e2e5;font-weight:600}
.term-tree .new{color:#7ddc8a;animation:msg .5s cubic-bezier(.16,1,.3,1) both}
.term-tree .new::after{content:"  新";font-size:11px;color:#7ddc8a}
.term-tree .mod{color:#f4b860}
.term-tree .mod::after{content:"  改";font-size:11px}
html[data-lang="en"] .term-tree .new::after{content:"  new"}
html[data-lang="en"] .term-tree .mod::after{content:"  edited"}
.term-tree .empty{color:#5b6a71;font-style:italic}
.term-steps{display:flex;gap:8px;padding:12px 16px;border-top:1px solid #22313a}
.term-steps i{flex:1;height:26px;border-radius:7px;background:#1f2b31;color:#5b6a71;font:600 12px/26px var(--mono);text-align:center;font-style:normal;transition:background .3s,color .3s}
.term-steps i.done{background:#16333a;color:#7fd1e2}
.term-steps i.on{background:#0d5f74;color:#fff}
.fx-steps{list-style:none;margin:0;padding:0}
.fx-step{min-height:62vh;padding:24px 0 24px 28px;border-left:2px solid var(--line);opacity:.35;transition:opacity .4s,border-color .4s;display:flex;flex-direction:column;justify-content:center}
.fx-step.on{opacity:1;border-color:var(--accent)}
.fx-step .no{font:600 14px var(--mono);color:var(--accent)}
.fx-step h3{font-size:clamp(24px,2.6vw,32px);margin:6px 0 16px}
.fx-step h3 small{font:500 14px var(--mono);color:var(--warm);margin-left:12px}
.fx-step .who{margin-bottom:12px}
.fx-step .who b{display:block;font:600 12px var(--mono);letter-spacing:.08em;color:var(--ink-muted);margin-bottom:2px}
.fx-step .who p{margin:0;font-size:17px;color:var(--ink-2)}
.inline-chat{display:none}
@media (max-width:860px){
  .fx-story{grid-template-columns:1fr}
  .fx-sticky{display:none}
  .fx-step{min-height:0;opacity:1;padding:18px 0 18px 18px}
  .inline-chat{display:grid;gap:8px;margin-top:6px}
  .inline-chat p{margin:0;padding:9px 13px;border-radius:13px;font-size:14px;max-width:92%}
  .inline-chat .me{justify-self:end;background:var(--accent);color:#fff}
  .inline-chat .ai{background:var(--surface-2)}
}
@media (prefers-reduced-motion:reduce){.term-chat p,.term-tree .new{animation:none}}
</style>
