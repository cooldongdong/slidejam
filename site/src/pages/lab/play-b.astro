---
// Cut B for the play page: each deck is pushed toward you as you scroll. It starts as a small
// card in the middle, grows to nearly full width, then steps left while its story slides in.
import Base from "../../layouts/Base.astro";
import { decks, deckStats } from "../../data/decks";
const B = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const list = decks.map((d, i) => ({ ...d, ...deckStats(d.file), n: String(i + 1).padStart(2, "0") }));
---
<Base title="範例 B：推到眼前 — slidejam" description="試做：往下捲，每份簡報從小卡被推到眼前。">
<section class="pb-hero wrap">
  <p class="kicker"><span lang="zh">範例</span><span lang="en">Examples</span></p>
  <h1><span lang="zh">四份簡報。<br><em>全部會動。</em></span><span lang="en">Four decks.<br><em>All of them move.</em></span></h1>
  <p class="pb-sub"><span lang="zh">往下捲，一份一份推到你眼前。</span><span lang="en">Scroll, and each one is pushed up close.</span></p>
</section>

{list.map((d) => (
  <section class="pb-ch" data-file={d.file}>
    <div class="pb-sticky">
      <span class="pb-num" aria-hidden="true">{d.n}</span>
      <div class="pb-frame"><iframe data-src={`${B}${d.file}?embed&tour=5`} tabindex="-1" title=""></iframe><img src={`${B}posters/${d.id}.jpg`} alt="" /></div>
      <div class="pb-info">
        <span class="no">{d.n} / {String(list.length).padStart(2, "0")}</span>
        <h2><span lang="zh">{d.zh[0]}</span><span lang="en">{d.en[0]}</span></h2>
        <p class="lead"><span lang="zh">{d.goal[0]}</span><span lang="en">{d.goal[1]}</span></p>
        <p class="meta"><span lang="zh">講給</span><span lang="en">For</span> {" "}<span lang="zh">{d.who[0]}</span><span lang="en">{d.who[1]}</span></p>
        <p class="chips">{d.fx.slice(0, 8).map((f) => <span>{f}</span>)}</p>
        <a class="btn primary" href={`${B}play/${d.id}/?slide=1`}><span lang="zh">播放 {d.slides} 頁</span><span lang="en">Play {d.slides} slides</span></a>
      </div>
    </div>
  </section>
))}

<script is:inline>
// progress through each chapter (0 → 1) drives the frame: grow in the middle, then step left
const chs = [...document.querySelectorAll(".pb-ch")];
const ease = (t) => 1 - Math.pow(1 - Math.min(1, Math.max(0, t)), 3);
function tick() {
  const vh = innerHeight, vw = innerWidth;
  chs.forEach((c) => {
    const r = c.getBoundingClientRect(), p = -r.top / (r.height - vh);
    const f = c.querySelector(".pb-frame"), info = c.querySelector(".pb-info"), num = c.querySelector(".pb-num");
    const grow = ease(p / 0.45), side = ease((p - 0.5) / 0.3);
    const big = Math.min(vw * 0.86, (vh - 120) * 16 / 9);
    const w = (0.34 + 0.66 * grow) * big * (1 - 0.36 * side);
    f.style.width = w + "px";
    f.style.transform = `translateX(${-side * vw * 0.2}px) rotateX(${(1 - grow) * 18}deg)`;
    info.style.opacity = side; info.style.transform = `translateX(${(1 - side) * 60}px)`;
    info.style.pointerEvents = side > 0.6 ? "auto" : "none";
    num.style.transform = `translateY(${(0.5 - p) * 30}vh)`;
    num.style.opacity = 0.9 - side * 0.6;
    const ifr = f.querySelector("iframe"), near = r.top < vh * 1.2 && r.bottom > -vh * 0.2;
    if (near && !ifr.src) { ifr.src = ifr.dataset.src; ifr.onload = () => f.classList.add("live"); }
    if (!near && ifr.src) { ifr.removeAttribute("src"); f.classList.remove("live"); }
  });
}
addEventListener("scroll", () => requestAnimationFrame(tick), { passive: true });
addEventListener("resize", tick);
tick();
</script>

<style is:global>
.pb-hero{padding-top:18vh;padding-bottom:12vh}
.pb-hero h1{font-size:clamp(56px,9vw,150px);line-height:.98;letter-spacing:-.045em;color:#fff;margin:12px 0 26px}
.pb-hero h1 em{font-style:normal;color:#7fd1e2}
.pb-sub{color:#8a9ca3;font-size:18px}
.pb-ch{height:300vh;position:relative}
.pb-sticky{position:sticky;top:64px;height:calc(100vh - 64px);display:grid;place-items:center;overflow:hidden;perspective:1600px}
.pb-num{position:absolute;font:700 clamp(240px,38vw,560px)/1 var(--mono);letter-spacing:-.08em;color:transparent;-webkit-text-stroke:2px rgb(127 209 226/.4);pointer-events:none;user-select:none}
.pb-frame{position:relative;aspect-ratio:16/9;border-radius:14px;overflow:hidden;background:#000;box-shadow:0 0 0 1px rgb(255 255 255/.1),0 80px 160px -40px rgb(0 0 0/.95);will-change:width,transform}
.pb-frame iframe,.pb-frame img{position:absolute;inset:0;width:100%;height:100%;border:0;object-fit:cover}
.pb-frame iframe{pointer-events:none}
.pb-frame.live img{opacity:0;transition:opacity .4s}
.pb-info{position:absolute;right:max(32px,5vw);top:50%;translate:0 -50%;width:min(420px,30vw);opacity:0}
.pb-info .no{font:13px var(--mono);color:#5b6a71;letter-spacing:.08em}
.pb-info h2{font-size:clamp(30px,3vw,46px);line-height:1.1;letter-spacing:-.02em;color:#fff;margin:10px 0 16px}
.pb-info .lead{color:#c1ccd0;font-size:16px;line-height:1.7}
.pb-info .meta{color:#7d9096;font-size:14px;margin:14px 0}
.pb-info .chips{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 22px}
.pb-info .chips span{font:12px var(--mono);color:#7fd1e2;background:rgb(127 209 226/.08);border:1px solid rgb(127 209 226/.18);padding:3px 9px;border-radius:999px}
@media (max-width:860px){.pb-ch{height:auto}.pb-sticky{position:relative;height:auto;padding:40px 20px;gap:24px}.pb-frame{width:100% !important;transform:none !important}.pb-info{position:static;translate:none;width:auto;opacity:1 !important;transform:none !important}.pb-num{display:none}}
</style>
</Base>
