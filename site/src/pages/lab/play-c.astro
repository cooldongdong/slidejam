---
// Cut C for the play page: film titles. Each deck plays full screen behind its title, one
// per screen, and scrolling snaps from one to the next.
import Base from "../../layouts/Base.astro";
import { decks, deckStats } from "../../data/decks";
const B = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const list = decks.map((d, i) => ({ ...d, ...deckStats(d.file), n: String(i + 1).padStart(2, "0") }));
---
<Base title="範例 C：片頭 — slidejam" description="試做：每份簡報滿版播放，像電影片頭。">
<div class="pc">
  {list.map((d, i) => (
    <section class="pc-ch">
      <div class="pc-bg"><iframe data-src={`${B}${d.file}?embed&tour=5`} tabindex="-1" title=""></iframe><img src={`${B}posters/${d.id}.jpg`} alt="" /></div>
      <div class="pc-title">
        {i === 0 && <p class="kicker"><span lang="zh">範例 · 這些簡報都是 slidejam 做的</span><span lang="en">Examples · all made with slidejam</span></p>}
        <span class="no">{d.n}</span>
        <h2><span lang="zh">{d.zh[0]}</span><span lang="en">{d.en[0]}</span></h2>
        <p class="lead"><span lang="zh">{d.goal[0]}</span><span lang="en">{d.goal[1]}</span></p>
        <p class="credits"><span><span lang="zh">講給</span><span lang="en">For</span> <b><span lang="zh">{d.who[0]}</span><span lang="en">{d.who[1]}</span></b></span><span><b>{d.slides}</b> <span lang="zh">頁</span><span lang="en">slides</span></span><span><span lang="zh">主題</span><span lang="en">theme</span> <b>{d.theme}</b></span><span><b>{d.fx.length}</b> <span lang="zh">種效果</span><span lang="en">effects</span></span></p>
        <a class="btn primary" href={`${B}play/${d.id}/?slide=1`}><span lang="zh">播放</span><span lang="en">Play</span></a>
      </div>
      {list.length - 1 > i && <span class="pc-next" aria-hidden="true"><span lang="zh">下一份</span><span lang="en">Next</span> ↓</span>}
    </section>
  ))}
</div>

<script is:inline>
// only the deck on screen plays; its title rises in when it arrives
const io = new IntersectionObserver((es) => es.forEach((e) => {
  const f = e.target.querySelector("iframe");
  e.target.classList.toggle("on", e.isIntersecting);
  if (e.isIntersecting && !f.src) { f.src = f.dataset.src; f.onload = () => e.target.classList.add("live"); }
  if (!e.isIntersecting && f.src) { f.removeAttribute("src"); e.target.classList.remove("live"); }
}), { threshold: 0.5 });
document.querySelectorAll(".pc-ch").forEach((c) => io.observe(c));
document.documentElement.classList.add("pc-snap");
</script>

<style is:global>
html.pc-snap{scroll-snap-type:y mandatory}
html.pc-snap footer{scroll-snap-align:end}
.pc-ch{position:relative;height:calc(100vh - 64px);min-height:560px;overflow:hidden;scroll-snap-align:end;display:flex;align-items:flex-end;background:#000}
/* cover: a 16:9 deck at least as big as the screen */
.pc-bg{position:absolute;left:50%;top:50%;width:max(100vw,calc((100vh - 64px) * 16 / 9));aspect-ratio:16/9;transform:translate(-50%,-50%) scale(1.06);transition:transform 6s ease-out}
.pc-ch.on .pc-bg{transform:translate(-50%,-50%)}
.pc-bg{filter:brightness(.8) saturate(.9)}
.pc-bg iframe,.pc-bg img{position:absolute;inset:0;width:100%;height:100%;border:0;object-fit:cover;pointer-events:none}
.pc-ch.live .pc-bg img{opacity:0;transition:opacity .5s}
.pc-ch::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgb(5 7 8/.97) 8%,rgb(5 7 8/.75) 34%,rgb(5 7 8/.1) 70%),linear-gradient(to right,rgb(5 7 8/.9) 10%,rgb(5 7 8/.55) 45%,transparent 75%);pointer-events:none}
.pc-title{position:relative;z-index:1;width:100%;max-width:1400px;margin:0 auto;padding:0 max(32px,5vw) 9vh}
.pc-title > *{opacity:0;transform:translateY(24px);transition:opacity .9s cubic-bezier(.16,1,.3,1),transform .9s cubic-bezier(.16,1,.3,1)}
.pc-ch.on .pc-title > *{opacity:1;transform:none}
.pc-ch.on .pc-title > :nth-child(2){transition-delay:.1s}.pc-ch.on .pc-title > :nth-child(3){transition-delay:.2s}.pc-ch.on .pc-title > :nth-child(4){transition-delay:.3s}.pc-ch.on .pc-title > :nth-child(5){transition-delay:.4s}.pc-ch.on .pc-title > :nth-child(6){transition-delay:.5s}
.pc-title .no{display:block;font:500 15px var(--mono);color:#7fd1e2;letter-spacing:.2em}
.pc-title h2{font-size:clamp(56px,8.5vw,140px);line-height:.95;letter-spacing:-.045em;color:#fff;margin:10px 0 22px;max-width:12em}
.pc-title .lead{color:#c9d4d8;font-size:clamp(16px,1.3vw,19px);line-height:1.7;max-width:36em;margin:0 0 22px}
.pc-title .credits{display:flex;flex-wrap:wrap;gap:8px 28px;font:13px var(--mono);color:#7d9096;text-transform:uppercase;letter-spacing:.06em;margin:0 0 28px}
.pc-title .credits b{color:#e8eef5;font-weight:500;text-transform:none}
.pc-next{position:absolute;right:32px;bottom:28px;z-index:1;font:12px var(--mono);color:#7d9096;letter-spacing:.1em}
</style>
</Base>
