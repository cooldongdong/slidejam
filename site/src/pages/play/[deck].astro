---
// A deck playing inside the site, so visitors keep the header and footer and can always
// get back. The deck itself is the untouched file copied into public/ (see copy-decks.mjs).
import Base from "../../layouts/Base.astro";

import { decks } from "../../data/decks";

export function getStaticPaths() {
  return decks.map((d) => ({ params: { deck: d.id }, props: { file: d.file, source: d.file, zh: d.zh, en: d.en } }));
}
const { file, source, zh, en } = Astro.props;
const B = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const src = B + file;
---
<Base title={`${zh[0]} — slidejam`} description={zh[1]} compact>
  <section class="player"><div class="wrap">
    <div class="player-head">
      <h1><span lang="zh">{zh[0]}</span><span lang="en">{en[0]}</span></h1>
      <p><span lang="zh">{zh[1]}</span><span lang="en">{en[1]}</span></p>
    </div>
    <div class="player-stage"><iframe id="deck" data-src={src} title={zh[0]} allow="fullscreen; clipboard-write" allowfullscreen></iframe></div>
    <div class="player-bar">
      <span class="hint"><span lang="zh">點一下投影片，就能用 ← → 翻頁；按 ? 看所有快捷鍵</span><span lang="en">Click the slide, then use ← → to move; press ? for every key</span></span>
      <span class="sp"></span>
      <a class="btn" id="open-full" href={src}><span lang="zh">全螢幕開啟 ↗</span><span lang="en">Open full screen ↗</span></a>
      <a class="btn" href={`https://github.com/cooldongdong/slidejam/blob/master/${source}`}><span lang="zh">看原始碼</span><span lang="en">Source</span></a>
    </div>
  </div></section>
</Base>

<script is:inline>
// pass ?query and #slide from the page URL on to the deck, so links like
// /play/effects/#bento or /play/effects/?wall open the right place
(() => {
  // the slide goes in as ?slide= rather than #, so the iframe doesn't scroll this page
  const f = document.getElementById("deck");
  const q = new URLSearchParams(location.search);
  if (location.hash) q.set("slide", decodeURIComponent(location.hash.slice(1)));
  const url = f.dataset.src + (q.toString() ? "?" + q : "");
  f.src = url;
  document.getElementById("open-full").href = url;
  // focus the deck so keys work at once, without scrolling the page past its title
  f.addEventListener("load", () => f.focus({ preventScroll: true }));
})();
</script>

<style is:global>
.player{padding:28px 0 36px}
.player-head{display:flex;align-items:baseline;gap:20px;flex-wrap:wrap;margin-bottom:16px}
.player-head h1{font-size:clamp(24px,3vw,32px);margin:0}
.player-head p{margin:0;color:var(--ink-2);font-size:16px;max-width:760px}
.player-stage{position:relative;aspect-ratio:16/9;max-height:calc(100vh - 230px);margin:0 auto;border-radius:14px;overflow:hidden;background:#0b1013;box-shadow:0 40px 80px -40px rgb(15 26 29/.45)}
.player-stage iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.player-bar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:14px}
.player-bar .hint{color:var(--ink-muted);font-size:14px}
.player-bar .sp{flex:1}
.player-bar .btn{padding:8px 16px;font-size:14px}
</style>
