---
// The screening room: decks made with slidejam play themselves on a big screen; pick a
// poster below to switch. Each poster lists what the deck is made of, read from the file.
import Base from "../../layouts/Base.astro";
import { decks, deckStats } from "../../data/decks";
const B = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const list = decks.map((d) => ({ ...d, ...deckStats(d.file) }));
const first = list[0];
---
<Base title="範例 — slidejam" description="用 slidejam 做的簡報，在放映室裡自己播放。挑一份，看它用了哪些效果。">
<section class="room">
  <div class="wrap room-head">
    <p class="kicker"><span lang="zh">放映室</span><span lang="en">Screening room</span></p>
    <h1><span lang="zh">用 slidejam 做的簡報</span><span lang="en">Decks made with slidejam</span></h1>
    <p class="room-sub"><span lang="zh">螢幕上的簡報會自己一頁一頁播。挑下面一份換台；想自己操作，就全螢幕打開。</span><span lang="en">The deck on screen plays itself. Pick another below to switch; open it full screen to drive it yourself.</span></p>
  </div>

  <div class="screen-wrap">
    <div class="glow" aria-hidden="true"></div>
    <div class="screen-frame" id="frame">
      <iframe id="screen" src={`${B}${first.file}?embed&tour=5`} title="slidejam deck" tabindex="-1"></iframe>
      <div class="static" aria-hidden="true"></div>
    </div>
    <div class="screen-bar">
      <b id="now"><span lang="zh">{first.zh[0]}</span><span lang="en">{first.en[0]}</span></b>
      <span class="sp"></span>
      <a class="btn primary" id="open" href={`${B}play/${first.id}/`}><span lang="zh">全螢幕打開 →</span><span lang="en">Open it →</span></a>
    </div>
  </div>

  <div class="wrap">
    <div class="posters">
      {list.map((d, i) => (
        <button class={`poster${i === 0 ? " on" : ""}`} data-file={d.file} data-id={d.id} data-zh={d.zh[0]} data-en={d.en[0]}>
          <span class="poster-img"><img src={`${B}posters/${d.id}.jpg`} alt="" /></span>
          <span class="poster-meta">
            <b><span lang="zh">{d.zh[0]}</span><span lang="en">{d.en[0]}</span></b>
            <small><span lang="zh">{d.zh[1]}</span><span lang="en">{d.en[1]}</span></small>
            <span class="facts">
              <span><span lang="zh">{d.slides} 頁</span><span lang="en">{d.slides} slides</span></span>
              <span><span lang="zh">主題 {d.theme}</span><span lang="en">theme {d.theme}</span></span>
              <span><span lang="zh">{d.fx.length} 種效果</span><span lang="en">{d.fx.length} effects</span></span>
            </span>
            <span class="fx-used">{d.fx.slice(0, 10).map((f) => <code>{f}</code>)}{d.fx.length > 10 && <code>+{d.fx.length - 10}</code>}</span>
          </span>
        </button>
      ))}
      <a class="poster poster-new" href={`${B}guide/`}>
        <span class="plus">+</span>
        <b><span lang="zh">下一份是你的</span><span lang="en">Yours next</span></b>
        <small><span lang="zh">在 Claude Code 輸入 /slidejam 開始</span><span lang="en">Type /slidejam in Claude Code</span></small>
      </a>
    </div>
  </div>
</section>
</Base>

<script is:inline define:vars={{ base: B }}>
// switch channels: a burst of static, then the new deck
const frame = document.getElementById("frame"), screen = document.getElementById("screen");
const now = document.getElementById("now"), open = document.getElementById("open");
document.querySelectorAll(".poster[data-file]").forEach((p) => p.addEventListener("click", () => {
  if (p.classList.contains("on")) return;
  document.querySelectorAll(".poster").forEach((x) => x.classList.toggle("on", x === p));
  frame.classList.add("switching");
  setTimeout(() => { screen.src = `${base}${p.dataset.file}?embed&tour=5`; }, 250);
  screen.onload = () => setTimeout(() => frame.classList.remove("switching"), 200);
  now.innerHTML = `<span lang="zh">${p.dataset.zh}</span><span lang="en">${p.dataset.en}</span>`;
  open.href = `${base}play/${p.dataset.id}/`;
  frame.scrollIntoView({ behavior: "smooth", block: "center" });
}));
// posters lean toward the pointer
document.querySelectorAll(".poster").forEach((p) => {
  p.addEventListener("pointermove", (e) => {
    const r = p.getBoundingClientRect(), x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
    p.style.transform = `perspective(900px) rotateY(${x * 10}deg) rotateX(${-y * 10}deg) translateY(-6px)`;
    p.style.setProperty("--gx", `${(x + 0.5) * 100}%`); p.style.setProperty("--gy", `${(y + 0.5) * 100}%`);
  });
  p.addEventListener("pointerleave", () => (p.style.transform = ""));
});
</script>

<style is:global>
.room{background:#07090a;color:#e8eef5;padding:56px 0 90px;min-height:100vh;overflow:hidden}
.room-head .kicker{color:#7fd1e2}
.room-head h1{font-size:clamp(34px,5vw,60px);line-height:1.1;margin:0;letter-spacing:-.02em;color:#fff}
.room-sub{color:#9fb0b4;font-size:18px;margin:16px 0 36px;max-width:640px}
/* the whole screen fits the window height */
.screen-wrap{position:relative;max-width:min(1180px,calc((100vh - 190px) * 16 / 9 + 48px));margin:0 auto;padding:0 24px}
.glow{position:absolute;left:10%;right:10%;top:12%;bottom:-6%;background:radial-gradient(closest-side,rgb(79 179 201/.28),transparent);filter:blur(40px);pointer-events:none}
.screen-frame{position:relative;aspect-ratio:16/9;border-radius:14px;overflow:hidden;background:#000;box-shadow:0 0 0 1px #1d2a30,0 60px 120px -30px rgb(0 0 0/.9),0 0 80px -10px rgb(79 179 201/.25)}
.screen-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0;pointer-events:none;transition:filter .25s,transform .25s}
.static{position:absolute;inset:0;opacity:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgb(255 255 255/.08) 0 1px,transparent 1px 3px),radial-gradient(circle,#3a4a50,#05080a);mix-blend-mode:screen;transition:opacity .2s}
.switching .static{opacity:1;animation:flick .12s steps(2) infinite}
.switching iframe{filter:brightness(1.8) contrast(.7) blur(2px);transform:scaleY(.96)}
@keyframes flick{50%{opacity:.6}}
.screen-bar{display:flex;align-items:center;gap:12px;margin-top:16px}
.screen-bar b{font-size:18px}
.screen-bar .sp{flex:1}
.posters{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:24px;margin-top:56px}
.poster{position:relative;display:flex;flex-direction:column;text-align:left;font:inherit;color:inherit;background:#10171a;border:1px solid #1d2a30;border-radius:16px;overflow:hidden;cursor:pointer;padding:0;transition:transform .2s ease-out,border-color .3s,box-shadow .3s;transform-style:preserve-3d;text-decoration:none}
.poster::after{content:"";position:absolute;inset:0;background:radial-gradient(400px circle at var(--gx,50%) var(--gy,0%),rgb(255 255 255/.08),transparent 40%);pointer-events:none}
.poster:hover{border-color:#33444c;box-shadow:0 30px 60px -30px rgb(0 0 0/.8)}
.poster.on{border-color:#4fb3c9;box-shadow:0 0 0 1px #4fb3c9,0 30px 60px -30px rgb(79 179 201/.45)}
.poster-img{display:block;aspect-ratio:16/9;overflow:hidden;background:#000}
.poster-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s}
.poster:hover .poster-img img{transform:scale(1.04)}
.poster-meta{display:grid;gap:8px;padding:16px 18px 18px}
.poster-meta b{font-size:19px;color:#fff}
.poster-meta small{color:#9fb0b4;font-size:14px;line-height:1.55}
.facts{display:flex;gap:14px;font:13px var(--mono);color:#7fd1e2}
.fx-used{display:flex;flex-wrap:wrap;gap:6px}
.fx-used code{font:12px var(--mono);color:#c7d6db;background:#1b262b;border-radius:6px;padding:2px 7px}
.poster-new{align-items:center;justify-content:center;gap:10px;min-height:280px;border-style:dashed;text-align:center;padding:24px}
.poster-new .plus{font:300 54px/1 var(--sans);color:#4fb3c9}
.poster-new b{font-size:19px;color:#fff}
.poster-new small{color:#9fb0b4;font-size:14px}
@media (prefers-reduced-motion:reduce){.switching .static{animation:none}}
</style>
