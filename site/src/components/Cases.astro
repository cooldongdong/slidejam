---
// Example decks. The page opens on a tilted wall where all of them play at once. Below it,
// one chapter per deck: scrolling pushes the deck up close, then it steps aside for its
// story. "Play" opens a theater where you drive the deck. Each chapter has its own address
// (/play/<id>/), and scrolling keeps it in sync.
import { decks, deckStats } from "../data/decks";
import { effects } from "../data/effects";
interface Props { current?: string }
const { current } = Astro.props;
const B = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const list = decks.map((d, i) => ({ ...d, ...deckStats(d.file), n: String(i + 1).padStart(2, "0") }));
const total = String(list.length).padStart(2, "0");
const slides = list.reduce((n, d) => n + d.slides, 0);
const ids = effects.map((e) => e.id);
const rowA = ids.slice(0, 16), rowC = ids.slice(16, 32);
---
<section class="pw-hero">
  <div class="pw-wall" aria-hidden="true">
    <div class="pw-row thin">{[...rowA, ...rowA].map((id) => <img src={`${B}thumbs/${id}.jpg`} alt="" />)}</div>
    <div class="pw-row live">
      {list.map((d) => <div class="pw-deck"><iframe src={`${B}${d.file}?embed&tour=4`} tabindex="-1" loading="lazy" title=""></iframe></div>)}
      {list.map((d) => <div class="pw-deck"><img src={`${B}posters/${d.id}.jpg`} alt="" /></div>)}
    </div>
    <div class="pw-row thin rev">{[...rowC, ...rowC].map((id) => <img src={`${B}thumbs/${id}.jpg`} alt="" />)}</div>
  </div>
  <div class="pw-text wrap">
    <p class="kicker"><span lang="zh">範例</span><span lang="en">Examples</span></p>
    <h1><span lang="zh">這些簡報，<br>都是 slidejam 做的</span><span lang="en">All made<br>with slidejam</span></h1>
    <p class="pw-stats"><b>{list.length}</b><span lang="zh">份簡報</span><span lang="en">decks</span><i></i><b>{slides}</b><span lang="zh">頁</span><span lang="en">slides</span><i></i><b>{ids.length}</b><span lang="zh">種效果</span><span lang="en">effects</span></p>
    <p class="pw-sub"><span lang="zh">背後這面牆，每一格都在真的播放。往下捲，一份一份看；想自己翻頁，按「播放」。</span><span lang="en">Every tile behind this is really playing. Scroll to take them one at a time; press Play to turn the pages yourself.</span></p>
  </div>
  <span class="pw-scroll" aria-hidden="true"></span>
</section>

<nav class="fx-mini play-mini" aria-label="decks">
  {list.map((d) => <a href={`${B}play/${d.id}/`} data-id={d.id}><i></i><span lang="zh">{d.zh[0]}</span><span lang="en">{d.en[0]}</span></a>)}
</nav>

{list.map((d) => (
  <section class="case" id={`case-${d.id}`} data-id={d.id} data-file={d.file} data-title-zh={d.zh[0]} data-title-en={d.en[0]}>
    <div class="case-sticky">
      <span class="case-num" aria-hidden="true">{d.n}</span>
      <div class="frame"><iframe data-src={`${B}${d.file}?embed&tour=5`} title={d.zh[0]} tabindex="-1"></iframe><img class="poster" src={`${B}posters/${d.id}.jpg`} alt="" /></div>
      <p class="tap-hint"><span lang="zh">點右邊下一頁、左邊上一頁，也可以左右滑</span><span lang="en">Tap right for next, left for back, or swipe</span></p>
      <div class="case-text">
        <span class="no">{d.n} / {total}</span>
        <h2><span lang="zh">{d.zh[0]}</span><span lang="en">{d.en[0]}</span></h2>
        <p class="lead"><span lang="zh">{d.zh[1]}</span><span lang="en">{d.en[1]}</span></p>
        <dl>
          <dt><span lang="zh">講給誰</span><span lang="en">For</span></dt><dd><span lang="zh">{d.who[0]}</span><span lang="en">{d.who[1]}</span></dd>
          <dt><span lang="zh">想做到</span><span lang="en">Aim</span></dt><dd><span lang="zh">{d.goal[0]}</span><span lang="en">{d.goal[1]}</span></dd>
          <dt><span lang="zh">用了</span><span lang="en">Uses</span></dt>
          <dd class="chips">{d.fx.slice(0, 12).map((f) => <a href={`${B}play/effects/?slide=${f}`}>{f}</a>)}{d.fx.length > 12 && <span>+{d.fx.length - 12}</span>}</dd>
        </dl>
        <p class="facts">{d.slides} <span lang="zh">頁</span><span lang="en">slides</span> · <span lang="zh">主題</span><span lang="en">theme</span> {d.theme}</p>
        <div class="actions">
          <button class="play"><span lang="zh">播放</span><span lang="en">Play</span></button>
          <button class="full"><span lang="zh">全螢幕</span><span lang="en">Full screen</span></button>
          <button class="share" data-url={`${B}play/${d.id}/`}><span lang="zh">複製連結</span><span lang="en">Copy link</span></button>
          <a class="plain" href={`https://github.com/cooldongdong/slidejam/blob/master/${d.file}`}><span lang="zh">原始碼</span><span lang="en">Source</span></a>
        </div>
      </div>
    </div>
  </section>
))}

<div class="theater" id="theater" hidden>
  <div class="th-bar">
    <b id="th-title"></b>
    <span class="hint"><span lang="zh">← → 翻頁・P 講者視窗・試試 E 改字、A 標註・? 看所有快捷鍵</span><span lang="en">← → to move · P for presenter view · try E to edit, A to annotate · ? for every key</span></span>
    <span class="sp"></span>
    <button id="th-full"><span lang="zh">全螢幕</span><span lang="en">Full screen</span></button>
    <button id="th-close"><span lang="zh">關閉</span><span lang="en">Close</span></button>
  </div>
  <div class="th-stage"><iframe id="th-frame" title="deck" allow="fullscreen; clipboard-write"></iframe></div>
</div>

<script is:inline define:vars={{ base: B, first: current ?? null }}>
const cases = [...document.querySelectorAll(".case")];
const lang = () => (document.documentElement.dataset.lang === "en" ? "en" : "zh");
const narrow = () => matchMedia("(max-width:960px)").matches;
const ease = (t) => 1 - Math.pow(1 - Math.min(1, Math.max(0, t)), 3);
// the scroll position where a chapter's story is fully showing
const storyTop = (c) => c.offsetTop + 0.85 * (c.offsetHeight - innerHeight);

// each chapter: progress 0 → 1 as it scrolls past. The deck grows from a small card to nearly
// full width, then steps left while its story slides in. Only decks near the screen play.
const mini = document.querySelector(".play-mini"), minis = [...mini.querySelectorAll("a")];
let shown = null;
function tick() {
  const vh = innerHeight, vw = innerWidth;
  let k = -1;
  cases.forEach((c, j) => {
    const r = c.getBoundingClientRect(), p = -r.top / (r.height - vh);
    if (k < 0 && r.top < vh / 2 && r.bottom > vh / 2) k = j;
    const f = c.querySelector(".frame"), text = c.querySelector(".case-text"), num = c.querySelector(".case-num");
    if (!narrow()) {
      const grow = ease(p / 0.45), side = ease((p - 0.5) / 0.3);
      const big = Math.min(vw * 0.86, (vh - 120) * 16 / 9);
      f.style.width = (0.34 + 0.66 * grow) * big * (1 - 0.36 * side) + "px";
      f.style.transform = `translateX(${-side * vw * 0.2}px) rotateX(${(1 - grow) * 18}deg)`;
      text.style.opacity = side; text.style.transform = `translateX(${(1 - side) * 60}px)`;
      text.style.pointerEvents = side > 0.6 ? "auto" : "none";
      num.style.transform = `translateY(${(0.5 - p) * 30}vh)`; num.style.opacity = 0.9 - side * 0.6;
    } else { f.style.width = f.style.transform = text.style.opacity = text.style.transform = text.style.pointerEvents = ""; }
    const ifr = f.querySelector("iframe"), near = r.top < vh * 1.2 && r.bottom > -vh * 0.2;
    if (near && !ifr.src) { ifr.src = ifr.dataset.src; ifr.onload = () => c.classList.add("live"); }
    if (!near && ifr.src) { ifr.removeAttribute("src"); c.classList.remove("live"); }
  });
  // the outline shows once the chapters begin; the address follows the chapter in view
  mini.classList.toggle("show", cases[0].getBoundingClientRect().top < vh * 0.6);
  minis.forEach((a, j) => { a.classList.toggle("on", j === k); a.classList.toggle("done", k > j); });
  const id = k >= 0 ? cases[k].dataset.id : null;
  if (id && id !== shown) { shown = id; if (theater.hidden) history.replaceState(null, "", `${base}play/${id}/${location.search}`); }
}
addEventListener("scroll", () => requestAnimationFrame(tick), { passive: true });
addEventListener("resize", tick);
minis.forEach((a, j) => a.addEventListener("click", (e) => { e.preventDefault(); scrollTo({ top: storyTop(cases[j]), behavior: "smooth" }); }));

// theater: the real deck, big, yours to drive
const theater = document.getElementById("theater"), tframe = document.getElementById("th-frame");
function open(c, slide, wall) {
  theaterCase = c;
  const q = [slide && `slide=${encodeURIComponent(slide)}`, wall && "wall"].filter(Boolean).join("&");
  tframe.src = `${base}${c.dataset.file}${q ? `?${q}` : ""}`;
  document.getElementById("th-title").textContent = c.dataset[lang() === "en" ? "titleEn" : "titleZh"];
  theater.hidden = false;
  requestAnimationFrame(() => theater.classList.add("on"));
  document.documentElement.style.overflow = "hidden";
  tframe.onload = () => {
    tframe.focus();
    // Esc inside the deck closes the theater, unless the deck has something of its own open
    // (overview, keys, themes, notes, edit or annotate) — then Esc is the deck's to handle.
    // In full screen, Esc with nothing open leaves full screen first.
    const w = tframe.contentWindow;
    w.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const d = w.document, busy = d.querySelector("#overview.show, #keys.show, #themes.show, #notes.show, #wall")
        || d.body.classList.contains("editing") || d.body.classList.contains("annotating");
      if (busy) return;
      e.stopImmediatePropagation();
      document.fullscreenElement ? document.exitFullscreen() : close();
    }, true);
  };
}
function close() {
  theater.classList.remove("on");
  document.documentElement.style.overflow = "";
  setTimeout(() => { theater.hidden = true; tframe.removeAttribute("src"); }, 300);
}
cases.forEach((c) => c.querySelector(".play").addEventListener("click", () => open(c)));
// on a phone the deck itself takes the taps; Play opens the theater
cases.forEach((c) => c.querySelector(".frame").addEventListener("click", () => narrow() || open(c)));
document.getElementById("th-close").onclick = close;
// Full screen: phones that allow it (Android, iPad) get the deck full screen, turned sideways
// when they let us; an iPhone only allows video full screen, so it opens the deck itself
// at the same slide, which fills the browser.
function fullScreen(frame, c) {
  const go = frame.requestFullscreen || frame.webkitRequestFullscreen;
  if (go) {
    return Promise.resolve(go.call(frame)).then(() => { frame.focus(); screen.orientation?.lock?.("landscape").catch(() => {}); }, () => openDeck(frame, c));
  }
  openDeck(frame, c);
}
function openDeck(frame, c) {
  let i = 0;
  try { i = frame.contentWindow.Deck.cur; } catch {}
  location.href = `${base}${c.dataset.file}?slide=${i + 1}`;
}
let theaterCase = null;
document.getElementById("th-full").onclick = () => fullScreen(tframe, theaterCase);
cases.forEach((c) => c.querySelector(".full").addEventListener("click", () => fullScreen(c.querySelector(".frame iframe"), c)));
addEventListener("keydown", (e) => { if (e.key === "Escape" && !theater.hidden) close(); });
// full screen (from the button, or F inside the deck): take Esc from the browser so it reaches
// the deck — the lock only works here, in the top page (Chrome, Edge)
document.addEventListener("fullscreenchange", () => {
  if (document.fullscreenElement) navigator.keyboard?.lock?.(["Escape"]).catch(() => {});
  else navigator.keyboard?.unlock?.();
});
theater.addEventListener("click", (e) => { if (e.target === theater || e.target.classList.contains("th-stage")) close(); });

// copy a chapter's own address
cases.forEach((c) => c.querySelector(".share").addEventListener("click", async (e) => {
  const b = e.currentTarget;
  try { await navigator.clipboard.writeText(new URL(b.dataset.url, location.href).href); b.classList.add("done"); setTimeout(() => b.classList.remove("done"), 1500); } catch {}
}));

tick();

// arriving at /play/<id>/: go straight to that chapter's story; ?slide=… opens it in the theater
(() => {
  if (!first) return;
  const c = document.getElementById(`case-${first}`);
  scrollTo({ top: narrow() ? c.offsetTop : storyTop(c) });
  tick();
  const q = new URLSearchParams(location.search);
  // ?slide=… opens the deck at a slide; ?wall opens its overview with every slide playing
  if (q.has("slide") || q.has("wall")) open(c, q.get("slide"), q.has("wall"));
})();
</script>

<style is:global>
/* ---- the wall: every deck playing at once, effect thumbnails above and below ---- */
.pw-hero{position:relative;height:calc(100vh - 64px);min-height:640px;overflow:hidden;background:#07090a;display:flex;align-items:center}
.pw-wall{position:absolute;inset:-25% -30%;display:grid;gap:26px;align-content:center;transform:perspective(1600px) rotateX(22deg) rotateZ(-9deg)}
.pw-row{display:flex;gap:26px;width:max-content;animation:pw-drift 120s linear infinite}
.pw-row.rev{animation-direction:reverse}
.pw-row.live{animation-duration:160s;margin-left:-180px}
.pw-row.thin img{width:300px;aspect-ratio:16/9;object-fit:cover;border-radius:10px;opacity:.35}
.pw-deck{width:640px;aspect-ratio:16/9;border-radius:14px;overflow:hidden;background:#000;box-shadow:0 0 0 1px rgb(255 255 255/.1),0 60px 120px -30px rgb(0 0 0/.9)}
.pw-deck iframe,.pw-deck img{width:100%;height:100%;border:0;display:block;object-fit:cover;pointer-events:none}
@keyframes pw-drift{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.pw-hero::after{content:"";position:absolute;inset:0;background:radial-gradient(60% 80% at 22% 55%,rgb(7 9 10/.95) 20%,rgb(7 9 10/.6) 55%,rgb(7 9 10/.1));pointer-events:none}
.pw-text{position:relative;z-index:1}
.pw-text h1{font-size:clamp(52px,7.4vw,112px);line-height:1.02;letter-spacing:-.035em;margin:10px 0 28px;color:#fff}
.pw-stats{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;font-size:17px;color:#9fb1b7;margin:0 0 18px}
.pw-stats b{font:600 44px var(--mono);color:#7fd1e2;letter-spacing:-.03em}
.pw-stats i{width:1px;height:28px;background:#2a3a40;margin:0 14px}
.pw-sub{color:#8a9ca3;font-size:17px;max-width:32em}
.pw-scroll{position:absolute;left:50%;bottom:28px;z-index:1;width:1px;height:56px;background:linear-gradient(#7fd1e2,transparent);animation:pw-scroll 2s ease-in-out infinite}
@keyframes pw-scroll{0%{transform:scaleY(0);transform-origin:top}50%{transform:scaleY(1);transform-origin:top}51%{transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}
.play-mini{position:fixed;right:28px;top:50%;transform:translateY(-50%);z-index:20;display:grid;gap:2px;font-size:13px;width:28px;opacity:0;transition:opacity .4s}
.play-mini:not(.show){pointer-events:none}
.play-mini.show{opacity:1}

/* ---- a chapter: the deck pushed up close, then its story ---- */
.case{height:220vh;position:relative}
.case-sticky{position:sticky;top:64px;height:calc(100vh - 64px);display:grid;place-items:center;overflow:hidden;perspective:1600px}
.case-num{position:absolute;font:700 clamp(240px,38vw,560px)/1 var(--mono);letter-spacing:-.08em;color:transparent;-webkit-text-stroke:2px rgb(127 209 226/.4);pointer-events:none;user-select:none}
.frame{position:relative;aspect-ratio:16/9;border-radius:14px;overflow:hidden;background:#000;cursor:pointer;box-shadow:0 0 0 1px rgb(255 255 255/.1),0 80px 160px -40px rgb(0 0 0/.95);will-change:width,transform}
.frame iframe,.frame .poster{position:absolute;inset:0;width:100%;height:100%;border:0;object-fit:cover}
.frame iframe{pointer-events:none}
.frame .poster{transition:opacity .5s}
.case.live .frame .poster{opacity:0;pointer-events:none}
.tap-hint{display:none}
.case-text{position:absolute;right:max(72px,6vw);top:50%;translate:0 -50%;width:min(430px,30vw);opacity:0}
.case-text .no{font:13px var(--mono);color:#5b6a71;letter-spacing:.08em}
.case-text h2{font-size:clamp(30px,3vw,46px);line-height:1.1;letter-spacing:-.02em;color:#fff;margin:10px 0 12px}
.case-text .lead{color:#8a9ca3;font-size:16px;margin:0 0 22px}
.case-text dl{display:grid;grid-template-columns:64px 1fr;gap:12px 18px;margin:0 0 20px;font-size:15px}
.case-text dt{color:#5b6a71;font-size:13px;padding-top:2px}
.case-text dd{margin:0;color:#c7d6db;line-height:1.6}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chips a,.chips span{font:12px var(--mono);color:#7fd1e2;background:rgb(127 209 226/.06);border:1px solid rgb(127 209 226/.18);border-radius:999px;padding:2px 9px;text-decoration:none}
.chips a:hover{color:#fff;border-color:#4fb3c9}
.case-text .facts{font:13px var(--mono);color:#5b6a71;margin:0 0 24px}
.actions{display:flex;align-items:center;gap:18px}
.actions .play{font:600 15px var(--sans);letter-spacing:.04em;border:0;border-radius:999px;padding:12px 30px;background:#e8eef5;color:#060708;cursor:pointer;transition:transform .2s,background .2s}
.actions .play:hover{background:#fff;transform:translateY(-1px)}
.actions .share,.actions .plain{font:500 14px var(--sans);border:0;background:none;color:#8a9ca3;cursor:pointer;text-decoration:none;padding:4px 0;border-bottom:1px solid transparent}
.actions .share:hover,.actions .plain:hover{color:#fff;border-bottom-color:#fff}
.actions .share.done{color:#7ddc8a}
.actions .full{display:none}
/* theater */
.theater{position:fixed;inset:0;z-index:50;display:flex;flex-direction:column;background:rgb(3 4 5/.94);backdrop-filter:blur(14px);opacity:0;transition:opacity .3s}
.theater[hidden]{display:none}
.theater.on{opacity:1}
.th-bar{display:flex;align-items:center;gap:18px;padding:16px 28px;color:#c7d6db;font-size:14px}
.th-bar b{color:#fff;font-size:16px}
.th-bar .hint{color:#5b6a71;font-size:13px}
.th-bar .sp{flex:1}
.th-bar button{font:500 14px var(--sans);border:0;background:none;color:#8a9ca3;cursor:pointer;padding:4px 0;border-bottom:1px solid transparent}
.th-bar button:hover{color:#fff;border-bottom-color:#fff}
.th-stage{flex:1;display:grid;place-items:center;padding:0 28px 28px;min-height:0}
.th-stage iframe{width:min(100%,calc((100vh - 110px) * 16 / 9));aspect-ratio:16/9;border:0;border-radius:10px;background:#000;box-shadow:0 60px 120px -40px rgb(0 0 0/.9);transform:scale(.96);transition:transform .4s cubic-bezier(.16,1,.3,1)}
.theater.on .th-stage iframe{transform:none}
@media (max-width:960px){
  .play-mini,.case-num{display:none}
  .case{height:auto;padding:40px 0}
  .case-sticky{position:relative;top:0;height:auto;display:grid;gap:28px;padding:0 20px;overflow:visible;perspective:none}
  .frame{width:100%;cursor:auto}
  /* on a phone the deck right here takes taps and swipes; Play still opens the theater */
  .frame iframe{pointer-events:auto}
  .actions .full{display:inline;font:500 14px var(--sans);border:0;background:none;color:#8a9ca3;cursor:pointer;padding:4px 0}
  .actions{flex-wrap:wrap}
  .tap-hint{display:block;margin:-16px 0 0;font:12px var(--mono);color:#5b6a71}
  .case-text{position:static;translate:none;width:auto;opacity:1}
  .th-bar .hint{display:none}
}
@media (prefers-reduced-motion:reduce){.pw-row,.pw-scroll{animation:none}}
</style>
