---
// The screening room. One deck on the big screen; the others wait in a stack behind it.
// Switch with the side arrows, ← → (while the deck isn't being driven) or by clicking the
// stack. Every deck has its own address (/play/<id>/); switching updates it in place.
import { decks, deckStats } from "../data/decks";
interface Props { current: string }
const { current } = Astro.props;
const B = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const list = decks.map((d, i) => ({ ...d, ...deckStats(d.file), n: String(i + 1).padStart(2, "0") }));
const cur = list.find((d) => d.id === current) ?? list[0];
const pad = (n: number) => String(n).padStart(2, "0");
---
<section class="room">
  <div class="room-top wrap">
    <div class="channel">
      <span class="ch-no" id="ch-no">{cur.n}<i> / {pad(list.length)}</i></span>
      <div class="ch-text">
        <h1 id="ch-title"><span lang="zh">{cur.zh[0]}</span><span lang="en">{cur.en[0]}</span></h1>
        <p id="ch-desc"><span lang="zh">{cur.zh[1]}</span><span lang="en">{cur.en[1]}</span></p>
      </div>
    </div>
    <ul class="ch-list">
      {list.map((d) => (
        <li><a href={`${B}play/${d.id}/`} data-id={d.id} class={d.id === cur.id ? "on" : undefined}><i>{d.n}</i><span lang="zh">{d.zh[0]}</span><span lang="en">{d.en[0]}</span></a></li>
      ))}
    </ul>
  </div>

  <div class="stage-row">
    <button class="side prev" id="ch-prev" aria-label="previous deck"><span lang="zh">上一份</span><span lang="en">Previous</span></button>
    <div class="screen-wrap">
      <div class="stack" id="stack">
        {list.map((d) => (
          <a class="card" href={`${B}play/${d.id}/`} data-id={d.id} data-file={d.file} data-slides={d.slides} data-n={d.n} data-zh={JSON.stringify(d.zh)} data-en={JSON.stringify(d.en)}>
            <img src={`${B}posters/${d.id}.jpg`} alt="" />
          </a>
        ))}
      </div>
      <div class="screen-frame" id="frame">
        <iframe id="screen" src={`${B}${cur.file}?embed&tour=5`} title="slidejam deck" tabindex="-1" allow="fullscreen; clipboard-write"></iframe>
      </div>
    </div>
    <button class="side next" id="ch-next" aria-label="next deck"><span lang="zh">下一份</span><span lang="en">Next</span></button>
  </div>

  <div class="room-bar wrap">
    <div class="seg" role="group">
      <button data-mode="auto" class="on"><span lang="zh">自動播放</span><span lang="en">Auto</span></button>
      <button data-mode="drive"><span lang="zh">自己操作</span><span lang="en">Drive</span></button>
    </div>
    <span class="hint" id="hint"><span lang="zh">← → 換一份簡報</span><span lang="en">← → switches deck</span></span>
    <span class="sp"></span>
    <button class="txt" id="prev"><span lang="zh">上一頁</span><span lang="en">Back</span></button>
    <span class="count" id="count">1 / {cur.slides}</span>
    <button class="txt" id="next"><span lang="zh">下一頁</span><span lang="en">Next</span></button>
    <span class="rule"></span>
    <button class="txt" id="full"><span lang="zh">全螢幕</span><span lang="en">Full screen</span></button>
    <a class="txt" id="src" href={`https://github.com/cooldongdong/slidejam/blob/master/${cur.file}`}><span lang="zh">原始碼</span><span lang="en">Source</span></a>
  </div>

  <div class="room-facts wrap" id="facts">
    {list.map((d) => (
      <div class="facts" data-id={d.id} hidden={d.id !== cur.id}>
        <span><b>{d.slides}</b><span lang="zh">頁</span><span lang="en">slides</span></span>
        <span><b>{d.theme}</b><span lang="zh">主題</span><span lang="en">theme</span></span>
        <span><b>{d.fx.length}</b><span lang="zh">種效果</span><span lang="en">effects</span></span>
        <span class="fx-used">{d.fx.map((f) => <code>{f}</code>)}</span>
      </div>
    ))}
  </div>
</section>

<script is:inline define:vars={{ base: B, first: cur.id }}>
const frame = document.getElementById("frame"), screen = document.getElementById("screen");
const cards = [...document.querySelectorAll("#stack .card")], order = cards.map((c) => c.dataset.id);
let current = first, mode = "auto", extra = "";
const card = (id) => cards.find((c) => c.dataset.id === id);
const win = () => { try { return screen.contentWindow.Deck ? screen.contentWindow : null; } catch { return null; } };
const lang = () => (document.documentElement.dataset.lang === "en" ? "en" : "zh");

// the stack behind the screen: the decks after this one, each a step further back
function layoutStack() {
  const i = order.indexOf(current);
  const rest = [...order.slice(i + 1), ...order.slice(0, i)];
  cards.forEach((c) => {
    const k = rest.indexOf(c.dataset.id);
    c.classList.toggle("live", k < 0);
    c.style.setProperty("--k", k < 0 ? 0 : k + 1);
    c.style.zIndex = k < 0 ? 0 : 10 - k;
  });
}
function src(slide) {
  const q = [];
  if (mode === "auto") q.push("embed", "tour=5");
  if (slide) q.push(`slide=${encodeURIComponent(slide)}`);
  return `${base}${card(current).dataset.file}?${q.join("&")}${extra}`;
}
function load(slide) {
  screen.src = src(slide); extra = "";
  screen.onload = () => { if (mode === "drive") screen.focus({ preventScroll: true }); };
  frame.classList.toggle("drive", mode === "drive");
  document.querySelectorAll(".seg button").forEach((b) => b.classList.toggle("on", b.dataset.mode === mode));
  document.getElementById("hint").hidden = mode === "drive";
}
function caption() {
  const c = card(current), z = JSON.parse(c.dataset.zh), e = JSON.parse(c.dataset.en);
  document.getElementById("ch-no").innerHTML = `${c.dataset.n}<i> / ${String(order.length).padStart(2, "0")}</i>`;
  document.getElementById("ch-title").innerHTML = `<span lang="zh">${z[0]}</span><span lang="en">${e[0]}</span>`;
  document.getElementById("ch-desc").innerHTML = `<span lang="zh">${z[1]}</span><span lang="en">${e[1]}</span>`;
  document.querySelectorAll(".ch-list a").forEach((a) => a.classList.toggle("on", a.dataset.id === current));
  document.querySelectorAll("#facts .facts").forEach((f) => (f.hidden = f.dataset.id !== current));
  document.getElementById("src").href = `https://github.com/cooldongdong/slidejam/blob/master/${c.dataset.file}`;
  document.title = `${lang() === "en" ? e[0] : z[0]} — slidejam`;
}
// change channel: the screen sinks back, the stack shifts, the new deck rises
function go(id, { push = true, slide } = {}) {
  if (id === current && !slide) return;
  frame.classList.add("out");
  document.querySelector(".room-top").classList.add("out");
  setTimeout(() => {
    current = id;
    layoutStack(); caption(); load(slide);
    frame.classList.remove("out"); frame.classList.add("in");
    document.querySelector(".room-top").classList.remove("out");
    setTimeout(() => frame.classList.remove("in"), 700);
  }, 380);
  if (push) history.pushState({ id }, "", `${base}play/${id}/`);
}
const step = (dir) => go(order[(order.indexOf(current) + dir + order.length) % order.length]);
document.getElementById("ch-prev").onclick = () => step(-1);
document.getElementById("ch-next").onclick = () => step(1);
cards.forEach((c) => c.addEventListener("click", (e) => { e.preventDefault(); go(c.dataset.id); }));
document.querySelectorAll(".ch-list a").forEach((a) => a.addEventListener("click", (e) => { e.preventDefault(); go(a.dataset.id); }));
addEventListener("popstate", () => { const id = location.pathname.split("/").filter(Boolean).pop(); if (order.includes(id)) go(id, { push: false }); });
addEventListener("keydown", (e) => {
  if (mode === "drive" || e.metaKey || e.ctrlKey || e.altKey || /INPUT|TEXTAREA/.test(e.target.tagName)) return;
  if (e.key === "ArrowLeft") { e.preventDefault(); step(-1); }
  if (e.key === "ArrowRight") { e.preventDefault(); step(1); }
});

// auto plays the deck by itself; drive hands it to you (click, keys, ?)
document.querySelectorAll(".seg button").forEach((b) => b.addEventListener("click", () => {
  if (b.dataset.mode === mode) return;
  const w = win(), at = w ? w.Deck.cur + 1 : null;
  mode = b.dataset.mode; load(at);
}));
const slideStep = (dir) => {
  const w = win();
  if (mode === "auto") { mode = "drive"; return load(w ? Math.max(1, w.Deck.cur + 1 + dir) : 1); }
  if (!w) return;
  dir > 0 ? w.Deck.next() : w.Deck.prev();
  screen.focus({ preventScroll: true });
};
document.getElementById("prev").onclick = () => slideStep(-1);
document.getElementById("next").onclick = () => slideStep(1);
document.getElementById("full").onclick = () => { frame.requestFullscreen?.(); if (mode === "drive") screen.focus(); };
setInterval(() => { const w = win(); if (w) document.getElementById("count").textContent = `${w.Deck.cur + 1} / ${w.Deck.slides.length}`; }, 400);
new MutationObserver(caption).observe(document.documentElement, { attributes: true, attributeFilter: ["data-lang"] });

// ?slide=bento (and &wall) opens this deck at a slide, driving
(() => {
  layoutStack();
  const q = new URLSearchParams(location.search);
  if (q.has("slide") || q.has("wall")) { mode = "drive"; if (q.has("wall")) extra = "&wall"; load(q.get("slide")); }
  history.replaceState({ id: current }, "", location.href);
})();
</script>

<style is:global>
.room{background:#060708;color:#e8eef5;padding:32px 0 100px;min-height:100vh;overflow:hidden}
.room-top{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;transition:opacity .35s,transform .35s cubic-bezier(.16,1,.3,1)}
.room-top.out{opacity:0;transform:translateY(-8px)}
.channel{display:flex;align-items:flex-end;gap:22px;min-width:0}
.ch-no{font:300 clamp(48px,6vw,84px)/.8 var(--mono);color:#fff;letter-spacing:-.04em}
.ch-no i{font-style:normal;font-size:.28em;color:#4a5a60;letter-spacing:0;vertical-align:top}
.ch-text h1{font-size:clamp(26px,3.2vw,40px);line-height:1.1;margin:0;color:#fff;font-weight:600;letter-spacing:-.01em}
.ch-text p{margin:8px 0 0;color:#8a9ca3;font-size:15px;max-width:620px}
.ch-list{list-style:none;margin:0;padding:0;display:flex;gap:18px;flex:none}
.ch-list a{display:flex;gap:8px;align-items:baseline;color:#5b6a71;text-decoration:none;font-size:14px;padding-bottom:6px;border-bottom:1px solid transparent;transition:color .2s,border-color .2s}
.ch-list a i{font:12px var(--mono);font-style:normal}
.ch-list a:hover{color:#c7d6db}
.ch-list a.on{color:#fff;border-color:#fff}
.stage-row{display:grid;grid-template-columns:90px 1fr 90px;align-items:center;max-width:1400px;margin:26px auto 0;padding:0 12px}
.side{height:100%;min-height:160px;border:0;background:none;color:#4a5a60;font:12px var(--sans);letter-spacing:.12em;cursor:pointer;position:relative;transition:color .25s}
.side::before{content:"";position:absolute;top:50%;left:50%;width:22px;height:22px;margin:-32px 0 0 -11px;border-left:1px solid currentColor;border-bottom:1px solid currentColor;transform:rotate(45deg)}
.side.next::before{transform:rotate(-135deg)}
.side span{display:block;margin-top:24px}
.side:hover{color:#e8eef5}
/* sized so the title, the screen and the peeking stack all fit one window */
.screen-wrap{position:relative;max-width:min(1120px,calc((100vh - 330px) * 16 / 9));width:100%;margin:0 auto;padding-bottom:70px}
.screen-frame{position:relative;z-index:20;aspect-ratio:16/9;border-radius:10px;overflow:hidden;background:#000;box-shadow:0 0 0 1px rgb(255 255 255/.06),0 70px 140px -40px rgb(0 0 0/.95);transition:transform .38s cubic-bezier(.6,0,.4,1),opacity .38s,filter .38s}
.screen-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0;pointer-events:none}
.screen-frame.drive iframe{pointer-events:auto}
.screen-frame.drive{box-shadow:0 0 0 1px rgb(127 209 226/.5),0 70px 140px -40px rgb(0 0 0/.95)}
.screen-frame.out{transform:translateY(46px) scale(.9);opacity:0;filter:blur(6px)}
.screen-frame.in{animation:rise .7s cubic-bezier(.16,1,.3,1)}
@keyframes rise{from{transform:translateY(-30px) scale(1.03);opacity:0;filter:blur(8px)}}
.screen-frame:fullscreen{border-radius:0;aspect-ratio:auto}
/* the stack: each waiting deck a step lower, smaller and darker, peeking out below */
.stack{position:absolute;inset:0 0 70px 0}
.stack .card{position:absolute;inset:0;border-radius:10px;overflow:hidden;background:#000;transform:translateY(calc(var(--k) * 34px)) scale(calc(1 - var(--k) * .06));transform-origin:50% 100%;filter:brightness(calc(.55 - var(--k) * .12));box-shadow:0 30px 60px -20px rgb(0 0 0/.9);transition:transform .6s cubic-bezier(.16,1,.3,1),filter .6s,opacity .4s;cursor:pointer}
.stack .card img{width:100%;height:100%;object-fit:cover;display:block}
.stack .card.live{opacity:0;pointer-events:none}
.stack .card:not(.live):hover{filter:brightness(.85);transform:translateY(calc(var(--k) * 34px + 8px)) scale(calc(1 - var(--k) * .06))}
.room-bar{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:6px}
.seg{display:flex;border:1px solid #1d2a30;border-radius:999px;padding:3px}
.seg button{font:500 13px var(--sans);letter-spacing:.04em;border:0;background:none;color:#7d9096;border-radius:999px;padding:7px 16px;cursor:pointer}
.seg button.on{background:#e8eef5;color:#060708}
.room-bar .hint{font-size:13px;color:#4a5a60}
.room-bar .sp{flex:1}
.txt{font:500 13px var(--sans);letter-spacing:.04em;border:0;background:none;color:#8a9ca3;padding:6px 4px;cursor:pointer;text-decoration:none;border-bottom:1px solid transparent}
.txt:hover{color:#fff;border-bottom-color:#fff}
.count{font:13px var(--mono);color:#5b6a71;min-width:64px;text-align:center}
.rule{width:1px;height:16px;background:#1d2a30}
.room-facts{margin-top:30px}
.facts{display:flex;align-items:baseline;gap:28px;flex-wrap:wrap;padding-top:22px;border-top:1px solid #141b1e;font-size:13px;color:#5b6a71}
.facts > span b{font:500 22px var(--mono);color:#e8eef5;margin-right:6px}
.facts .fx-used{display:flex;flex-wrap:wrap;gap:6px;flex:1}
.facts code{font:12px var(--mono);color:#8a9ca3;border:1px solid #1d2a30;border-radius:999px;padding:2px 9px}
@media (max-width:860px){
  .room-top{flex-direction:column;align-items:flex-start}
  .stage-row{grid-template-columns:1fr;padding:0 16px}
  .side{display:none}
  .screen-wrap{padding-bottom:50px}
  .room-bar .hint,.rule{display:none}
}
@media (prefers-reduced-motion:reduce){.screen-frame,.stack .card{transition:none}.screen-frame.in{animation:none}}
</style>
